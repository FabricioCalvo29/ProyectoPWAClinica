@model Proyecto_PWA_Clinica.Models.RestablecerAccesoViewModel
@{
    Layout = "_Layout";
}

<style>
body { background-color: #040d1a !important; }
.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px; position: relative;
    display: flex; align-items: center;
}
.page-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
}
.form-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 24px; overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,.35);
    position: relative; z-index: 1;
}
.form-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 32px 36px 26px; text-align: center;
}
.form-card-header .header-icon {
    width: 56px; height: 56px; border-radius: 18px;
    background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #0d9488; margin: 0 auto 16px;
}
.form-card-header h1 { font-size: 1.4rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
.form-card-header p  { color: rgba(255,255,255,.4); font-size: .88rem; margin: 0; }
.form-card-body { padding: 32px 36px 36px; }
.form-label-dark {
    display: block; font-size: .78rem; font-weight: 700;
    color: rgba(255,255,255,.5); letter-spacing: .06em;
    text-transform: uppercase; margin-bottom: 8px;
}
.form-input-wrap { position: relative; }
.form-input-wrap .bi {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,.25); font-size: .95rem; pointer-events: none;
}
.dark-input {
    width: 100%;
    background: rgba(255,255,255,.06);
    border: 1.5px solid rgba(255,255,255,.1);
    border-radius: 12px;
    padding: 12px 14px 12px 42px;
    color: #fff; font-size: .9rem;
    transition: border-color .2s, background .2s; outline: none;
}
.dark-input::placeholder { color: rgba(255,255,255,.2); }
.dark-input:focus { border-color: rgba(13,148,136,.6); background: rgba(13,148,136,.07); }
.field-wrap { margin-bottom: 20px; }
.field-error { color: #f87171; font-size: .78rem; margin-top: 5px; display: block; }
.dark-alert-danger {
    border-radius: 12px; padding: 13px 18px; font-size: .88rem; margin-bottom: 20px;
    display: flex; align-items: center; gap: 10px;
    background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); color: #fca5a5;
}
.form-section-label {
    font-size: .7rem; font-weight: 700; color: rgba(13,148,136,.7);
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 18px;
    display: flex; align-items: center; gap: 10px;
}
.form-section-label::after {
    content: ''; flex: 1; height: 1px; background: rgba(13,148,136,.15);
}
.btn-primary-dark {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    background: #0d9488; color: #fff; border: none; border-radius: 12px;
    padding: 13px; font-size: .92rem; font-weight: 700; margin-top: 8px;
    cursor: pointer; transition: background .2s, transform .15s;
}
.btn-primary-dark:hover { background: #0f766e; transform: translateY(-1px); }
</style>

<div class="page-wrap">
    <div class="container" style="max-width: 460px;">
        <div class="form-card" data-aos="fade-up">
            <div class="form-card-header">
                <div class="header-icon"><i class="bi bi-key"></i></div>
                <h1>Restablecer contraseña</h1>
                <p>Ingresa y confirma tu nueva contraseña</p>
            </div>
            <div class="form-card-body">
                <form asp-action="RestablecerAcceso" asp-controller="Home" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Token" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="dark-alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <div class="form-section-label"><i class="bi bi-lock"></i> Nueva contraseña</div>

                    <div class="field-wrap">
                        <label asp-for="NuevaContrasena" class="form-label-dark"></label>
                        <div class="form-input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="NuevaContrasena" type="password" class="dark-input" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="field-error"></span>
                    </div>

                    <div class="field-wrap">
                        <label asp-for="ConfirmarContrasena" class="form-label-dark"></label>
                        <div class="form-input-wrap">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ConfirmarContrasena" type="password" class="dark-input" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="field-error"></span>
                    </div>

                    <button type="submit" class="btn-primary-dark">
                        <i class="bi bi-check-lg"></i> Actualizar contraseña
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
