@model Proyecto_PWA_Clinica.Models.EstadisticasMedico

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new();
}

<style>
body { background-color: #040d1a !important; }
.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px; position: relative;
}
.page-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
}
/* hero */
.dash-hero { position: relative; z-index: 1; margin-bottom: 32px; }
.dash-hero .stethoscope-icon {
    width: 52px; height: 52px; border-radius: 16px;
    background: rgba(13,148,136,.15); border: 1.5px solid rgba(13,148,136,.35);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #0d9488; margin-bottom: 14px;
}
.dash-hero h1 { font-size: 1.7rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
.dash-hero p  { color: rgba(255,255,255,.4); font-size: .92rem; margin: 0; }
/* stats */
.stats-row {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr));
    gap: 14px; margin-bottom: 30px; position: relative; z-index: 1;
}
.stat-card {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; padding: 20px 22px;
    display: flex; align-items: center; gap: 14px;
    transition: background .2s;
}
.stat-card:hover { background: rgba(255,255,255,.06); }
.stat-card .s-icon {
    width: 46px; height: 46px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; flex-shrink: 0;
}
.s-teal  .s-icon { background:rgba(13,148,136,.15); color:#0d9488; border:1px solid rgba(13,148,136,.25); }
.s-amber .s-icon { background:rgba(245,158,11,.15); color:#f59e0b; border:1px solid rgba(245,158,11,.25); }
.s-green .s-icon { background:rgba(16,185,129,.15); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.s-blue  .s-icon { background:rgba(99,102,241,.15); color:#818cf8; border:1px solid rgba(99,102,241,.25); }
.s-num { font-size: 1.7rem; font-weight: 800; color: #fff; line-height: 1; }
.s-lbl { font-size: .7rem; color: rgba(255,255,255,.35); text-transform: uppercase; letter-spacing: .05em; margin-top: 3px; }
/* dark card */
.dark-card {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 22px; overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,.28);
    position: relative; z-index: 1;
}
.dark-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 16px 24px;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
.dark-card-header .ch-left { display: flex; align-items: center; gap: 10px; }
.dark-card-header .ch-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; color: #0d9488;
}
.dark-card-header .ch-title { font-size: .93rem; font-weight: 700; color: #fff; }
/* cita item */
.cita-item {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 16px 24px; border-bottom: 1px solid rgba(255,255,255,.04);
    gap: 14px; flex-wrap: wrap;
    transition: background .15s;
}
.cita-item:last-child { border-bottom: none; }
.cita-item:hover { background: rgba(13,148,136,.04); }
.cita-main .ci-name { font-size: .93rem; font-weight: 700; color: #fff; margin-bottom: 2px; }
.cita-main .ci-spec { font-size: .78rem; color: #0d9488; margin-bottom: 2px; }
.cita-main .ci-motivo { font-size: .77rem; color: rgba(255,255,255,.3); }
.cita-right { text-align: right; flex-shrink: 0; }
.date-badge {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(99,102,241,.12); color: #818cf8;
    border: 1px solid rgba(99,102,241,.2);
    border-radius: 8px; padding: 3px 10px;
    font-size: .75rem; font-weight: 700; margin-bottom: 4px;
}
.time-label { font-size: .75rem; color: rgba(255,255,255,.3); margin-bottom: 8px; display: block; }
.btn-atender {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(13,148,136,.1); color: #0d9488;
    border: 1px solid rgba(13,148,136,.25); border-radius: 8px;
    padding: 5px 12px; font-size: .77rem; font-weight: 700;
    text-decoration: none; transition: background .15s;
}
.btn-atender:hover { background: rgba(13,148,136,.22); color: #5eead4; }
/* quick access */
.qa-item {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 22px; border-bottom: 1px solid rgba(255,255,255,.05);
    text-decoration: none; color: rgba(255,255,255,.7);
    transition: background .15s, color .15s;
}
.qa-item:last-child { border-bottom: none; }
.qa-item:hover { background: rgba(13,148,136,.07); color: #fff; }
.qa-icon {
    width: 40px; height: 40px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem; flex-shrink: 0;
    background: rgba(13,148,136,.12); color: #0d9488;
    border: 1px solid rgba(13,148,136,.2);
}
.qa-item h6 { font-size: .87rem; font-weight: 700; color: inherit; margin: 0; }
/* empty */
.empty-inline { padding: 48px 20px; text-align: center; color: rgba(255,255,255,.3); font-size: .87rem; }
.empty-inline i { display: block; font-size: 1.8rem; margin-bottom: 10px; color: rgba(255,255,255,.12); }
/* btn ghost sm */
.btn-ghost-sm {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; color: rgba(255,255,255,.4);
    border: 1.5px solid rgba(255,255,255,.12); border-radius: 9px;
    padding: 6px 14px; font-size: .8rem; font-weight: 600;
    text-decoration: none; transition: border-color .2s, color .2s;
}
.btn-ghost-sm:hover { border-color: rgba(255,255,255,.3); color: #fff; }
</style>

<div class="page-wrap">
    <div class="container-xl" style="max-width:1160px;">

        <!-- Hero -->
        <div class="dash-hero" data-aos="fade-down">
            <div class="stethoscope-icon"><i class="bi bi-hospital"></i></div>
            <h1>Panel Médico</h1>
            <p>Bienvenido/a, <strong style="color:rgba(255,255,255,.7);">Dr(a). @ViewBag.NombreUsuario</strong></p>
        </div>

        <!-- Stats -->
        <div class="stats-row" data-aos="fade-up" data-aos-delay="50">
            <div class="stat-card s-teal">
                <div class="s-icon"><i class="bi bi-calendar-day-fill"></i></div>
                <div><div class="s-num">@Model.CitasHoy</div><div class="s-lbl">Citas de hoy</div></div>
            </div>
            <div class="stat-card s-amber">
                <div class="s-icon"><i class="bi bi-hourglass-split"></i></div>
                <div><div class="s-num">@Model.CitasPendientes</div><div class="s-lbl">Pendientes</div></div>
            </div>
            <div class="stat-card s-green">
                <div class="s-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div><div class="s-num">@Model.CitasCompletadas</div><div class="s-lbl">Completadas</div></div>
            </div>
            <div class="stat-card s-blue">
                <div class="s-icon"><i class="bi bi-people-fill"></i></div>
                <div><div class="s-num">@Model.TotalPacientesAtendidos</div><div class="s-lbl">Pacientes atendidos</div></div>
            </div>
        </div>

        <!-- Grid -->
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">

            <!-- Próximas citas -->
            <div class="col-lg-8">
                <div class="dark-card h-100">
                    <div class="dark-card-header">
                        <div class="ch-left">
                            <div class="ch-icon"><i class="bi bi-calendar2-week"></i></div>
                            <span class="ch-title">Próximas citas</span>
                        </div>
                        <a asp-controller="Citas" asp-action="MedicoIndex" class="btn-ghost-sm">
                            Ver todas <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    @if (citas.Any())
                    {
                        @foreach (var cita in citas.OrderBy(c => c.FechaHora).Take(5))
                        {
                            <div class="cita-item">
                                <div class="cita-main">
                                    <div class="ci-name">@cita.NombrePaciente</div>
                                    <div class="ci-spec">@cita.Especialidad</div>
                                    <div class="ci-motivo">@cita.Motivo</div>
                                </div>
                                <div class="cita-right">
                                    <div class="date-badge"><i class="bi bi-calendar3"></i> @cita.FechaHora.ToString("dd/MM/yyyy")</div>
                                    <span class="time-label">@cita.FechaHora.ToString("HH:mm")</span>
                                    <a asp-controller="Citas" asp-action="MedicoDetails" asp-route-id="@cita.IdCita" class="btn-atender">
                                        <i class="bi bi-stethoscope"></i> Atender
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-inline">
                            <i class="bi bi-calendar-x"></i>
                            No hay citas registradas para este médico.
                        </div>
                    }
                </div>
            </div>

            <!-- Accesos rápidos -->
            <div class="col-lg-4">
                <div class="dark-card h-100">
                    <div class="dark-card-header">
                        <div class="ch-left">
                            <div class="ch-icon"><i class="bi bi-grid-1x2"></i></div>
                            <span class="ch-title">Accesos rápidos</span>
                        </div>
                    </div>
                    <div>
                        <a asp-controller="Citas" asp-action="MedicoIndex" class="qa-item">
                            <div class="qa-icon"><i class="bi bi-list-check"></i></div>
                            <div>
                                <h6>Mis Citas</h6>
                                <span style="font-size:.76rem; color:rgba(255,255,255,.3);">Ver y gestionar tu agenda</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
