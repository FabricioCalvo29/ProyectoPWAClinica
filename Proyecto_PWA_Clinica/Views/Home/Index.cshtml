@{
    Layout = "_Layout";
}

<style>
/* neutralizar fondo blanco del body en esta página */
body { background-color: #040d1a !important; }

/* ══ HERO ════════════════════════════════════════════════ */
.hero-pro {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #040d1a;
}
.hero-bg { position: absolute; inset: 0; z-index: 0; }
.hero-bg img { width:100%; height:100%; object-fit:cover; opacity:.18; }
.hero-bg::after {
    content:''; position:absolute; inset:0;
    background: linear-gradient(135deg, rgba(4,13,26,.97) 0%, rgba(4,13,26,.75) 60%, rgba(8,30,60,.9) 100%);
}
.hero-grid {
    position:absolute; inset:0; z-index:1; pointer-events:none;
    background-image:
        linear-gradient(rgba(13,148,136,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.06) 1px, transparent 1px);
    background-size: 60px 60px;
}
.hero-body {
    position:relative; z-index:2;
    flex:1; display:flex; align-items:center;
    padding: 140px 0 80px;
}
.hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(13,148,136,.15);
    border:1px solid rgba(13,148,136,.35);
    border-radius:50px; padding:6px 16px; margin-bottom:28px;
}
.hero-eyebrow .dot {
    width:7px; height:7px; background:#0d9488; border-radius:50%;
    animation: blink 2s infinite;
}
@@keyframes blink {
    0%,100%{opacity:1;transform:scale(1)}
    50%{opacity:.4;transform:scale(.7)}
}
.hero-eyebrow span { font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#0d9488; }
.hero-title {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight:800; line-height:1.1; color:#fff;
    margin-bottom:20px; letter-spacing:-.02em;
}
.hero-title .accent { color:#0d9488; }
.hero-sub {
    font-size:1.05rem; color:rgba(255,255,255,.6);
    line-height:1.75; margin-bottom:36px; max-width:520px;
}
.btn-hm {
    display:inline-flex; align-items:center; gap:8px;
    background:#0d9488; color:#fff;
    font-size:.9rem; font-weight:700;
    padding:14px 28px; border-radius:12px;
    text-decoration:none; transition:background .2s, transform .15s;
}
.btn-hm:hover { background:#0f766e; color:#fff; transform:translateY(-2px); }
.btn-ho {
    display:inline-flex; align-items:center; gap:8px;
    background:transparent; color:rgba(255,255,255,.85);
    font-size:.9rem; font-weight:600;
    padding:14px 28px; border-radius:12px;
    text-decoration:none;
    border:1.5px solid rgba(255,255,255,.2);
    transition:border-color .2s, color .2s;
}
.btn-ho:hover { border-color:rgba(255,255,255,.5); color:#fff; }

/* ── GROUP BAR ── */
.group-bar {
    position:relative; z-index:2;
    background:rgba(255,255,255,.04);
    border-top:1px solid rgba(255,255,255,.07);
    padding:16px 0;
}
.gb-inner { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
.gb-pill {
    background:#0d9488; color:#fff;
    font-size:.7rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase;
    padding:5px 14px; border-radius:50px; white-space:nowrap; flex-shrink:0;
}
.gb-course { font-size:.8rem; font-weight:600; color:rgba(255,255,255,.5); white-space:nowrap; }
.gb-sep { color:rgba(255,255,255,.2); }
.gb-students { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
.gb-name { font-size:.78rem; color:rgba(255,255,255,.65); font-weight:500; display:flex; align-items:center; gap:5px; }
.gb-name i { color:#0d9488; font-size:.72rem; }

/* ══ TRUST BAR ══════════════════════════════════════════ */
.trust-bar {
    background:#071428;
    border-bottom:1px solid rgba(255,255,255,.06);
    padding:40px 0;
}
.trust-item { text-align:center; padding:0 12px; }
.trust-num {
    font-size:2.4rem; font-weight:900; color:#fff;
    letter-spacing:-.03em; line-height:1;
    margin-bottom:6px;
}
.trust-num span { color:#0d9488; }
.trust-label { font-size:.78rem; color:rgba(255,255,255,.4); font-weight:600; letter-spacing:.06em; text-transform:uppercase; }
.trust-divider {
    width:1px; height:48px;
    background:rgba(255,255,255,.08);
    align-self:center;
}

/* ══ SVG WAVE DIVIDER ══════════════════════════════════ */
.wave-divider { display:block; line-height:0; overflow:hidden; }
.wave-divider svg { display:block; width:100%; }

/* ══ SECTIONS ══════════════════════════════════════════ */
.sec { padding:88px 0; }
.sec-dark  { background:#040d1a; }
.sec-dark2 { background:#071428; }

.sec-dark  .sh h2,
.sec-dark2 .sh h2 { color:#fff; }
.sec-dark  .sh p,
.sec-dark2 .sh p  { color:rgba(255,255,255,.5); }

.sh { text-align:center; margin-bottom:52px; }
.sh h2 { font-size:2rem; font-weight:800; letter-spacing:-.02em; margin-bottom:10px; }
.sh p  { font-size:1rem; max-width:480px; margin:0 auto; }
.sh-bar { width:44px; height:4px; background:#0d9488; border-radius:2px; margin:14px auto 0; }

/* ══ CÓMO FUNCIONA ══════════════════════════════════════ */
.steps-wrap { position:relative; }
.steps-line {
    position:absolute; top:36px; left:50%; transform:translateX(-50%);
    width:60%; height:2px;
    background:linear-gradient(90deg, transparent, rgba(13,148,136,.4), transparent);
    display:none;
}
@@media(min-width:992px){ .steps-line { display:block; } }
.step-card { text-align:center; padding:0 16px; }
.step-num {
    width:72px; height:72px; border-radius:50%;
    background:rgba(13,148,136,.12);
    border:2px solid rgba(13,148,136,.35);
    display:flex; align-items:center; justify-content:center;
    margin:0 auto 20px;
    font-size:1.5rem; color:#0d9488;
    position:relative; z-index:1;
    transition:background .3s, border-color .3s;
}
.step-card:hover .step-num {
    background:rgba(13,148,136,.25);
    border-color:#0d9488;
}
.step-card h5 { font-size:1rem; font-weight:800; color:#fff; margin-bottom:8px; }
.step-card p  { font-size:.85rem; color:rgba(255,255,255,.45); line-height:1.65; max-width:220px; margin:0 auto; }

/* ══ DEPT CARDS ════════════════════════════════════════ */
.dc {
    border-radius:20px; overflow:hidden; height:100%;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.09);
    transition:transform .25s, box-shadow .25s;
}
.dc:hover { transform:translateY(-6px); box-shadow:0 20px 48px rgba(0,0,0,.3); }
.dc .dc-img { position:relative; height:190px; overflow:hidden; }
.dc .dc-img img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
.dc:hover .dc-img img { transform:scale(1.06); }
.dc-badge {
    position:absolute; top:14px; left:14px;
    background:rgba(13,148,136,.9); color:#fff;
    font-size:.68rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase;
    padding:4px 12px; border-radius:50px;
}
.dc-body { padding:24px; }
.dc-icon {
    width:44px; height:44px; border-radius:12px;
    background:rgba(13,148,136,.15);
    display:flex; align-items:center; justify-content:center;
    color:#0d9488; font-size:1.2rem; margin-bottom:14px;
}
.dc-body h3 { font-size:1.1rem; font-weight:800; color:#fff; margin-bottom:8px; }
.dc-body p  { font-size:.87rem; color:rgba(255,255,255,.5); line-height:1.65; margin-bottom:18px; }
.dc-link {
    display:inline-flex; align-items:center; gap:6px;
    color:#0d9488; font-size:.85rem; font-weight:700;
    text-decoration:none; transition:gap .2s;
}
.dc-link:hover { gap:10px; }

/* ══ DOCTOR CARDS ══════════════════════════════════════ */
.doc {
    border-radius:20px; overflow:hidden; height:100%;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.09);
    transition:transform .25s, box-shadow .25s;
    position:relative;
}
.doc:hover { transform:translateY(-6px); box-shadow:0 20px 48px rgba(0,0,0,.3); }
.doc .di { position:relative; height:230px; overflow:hidden; }
.doc .di img { width:100%; height:100%; object-fit:cover; object-position:top; transition:transform .4s; }
.doc:hover .di img { transform:scale(1.05); }

/* overlay hover en médicos */
.doc-overlay {
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(4,13,26,.92) 0%, transparent 55%);
    opacity:0; transition:opacity .3s;
    display:flex; align-items:flex-end; padding:16px;
    pointer-events:none;
}
.doc:hover .doc-overlay { opacity:1; }
.doc-overlay-info { width:100%; }
.doc-overlay-info p { font-size:.75rem; color:rgba(255,255,255,.7); margin:0 0 4px; }
.doc-overlay-info .schedule { font-size:.8rem; font-weight:700; color:#0d9488; }

.avail {
    position:absolute; top:14px; right:14px;
    font-size:.68rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase;
    padding:5px 13px; border-radius:50px; z-index:2;
}
.avail.on  { background:#dcfce7; color:#15803d; }
.avail.off { background:#fef9c3; color:#a16207; }
.db { padding:20px 22px 22px; }
.db h5 {
    font-size:1rem; font-weight:800; color:#fff; margin-bottom:3px;
    display:flex; align-items:center; gap:6px;
}
.db h5 .verified { color:#0d9488; font-size:.85rem; }
.db .ds { font-size:.8rem; color:#0d9488; font-weight:700; margin-bottom:2px; }
.db .de { font-size:.78rem; color:rgba(255,255,255,.35); margin-bottom:10px; }
.stars { display:flex; align-items:center; gap:3px; margin-bottom:16px; }
.stars i { color:#f59e0b; font-size:.8rem; }
.stars span { font-size:.78rem; color:rgba(255,255,255,.35); margin-left:4px; }
.dac { display:flex; gap:8px; }
.btn-dp {
    flex:1; padding:9px; border-radius:10px; font-size:.82rem; font-weight:700;
    border:1.5px solid rgba(13,148,136,.6); color:#0d9488; background:transparent;
    text-align:center; text-decoration:none; transition:background .2s, color .2s;
}
.btn-dp:hover { background:#0d9488; color:#fff; border-color:#0d9488; }
.btn-dc {
    flex:1; padding:9px; border-radius:10px; font-size:.82rem; font-weight:700;
    background:#0d9488; color:#fff; border:none;
    text-align:center; text-decoration:none; transition:opacity .2s;
}
.btn-dc:hover { opacity:.87; color:#fff; }

/* ══ TESTIMONIOS ═══════════════════════════════════════ */
.tcard {
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.09);
    border-radius:20px; padding:28px;
    height:100%; transition:transform .25s, box-shadow .25s;
    position:relative;
}
.tcard:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(0,0,0,.25); }
.tcard-quote {
    font-size:2.5rem; line-height:1; color:#0d9488;
    font-family:Georgia, serif; margin-bottom:12px;
}
.tcard p {
    font-size:.9rem; color:rgba(255,255,255,.6);
    line-height:1.75; margin-bottom:20px; font-style:italic;
}
.tcard-author { display:flex; align-items:center; gap:12px; }
.tcard-avatar {
    width:44px; height:44px; border-radius:50%;
    background:rgba(13,148,136,.2);
    border:2px solid rgba(13,148,136,.4);
    display:flex; align-items:center; justify-content:center;
    font-size:1rem; color:#0d9488; font-weight:800; flex-shrink:0;
}
.tcard-info strong { display:block; font-size:.88rem; color:#fff; font-weight:700; }
.tcard-info span   { font-size:.76rem; color:rgba(255,255,255,.35); }
.tcard-stars { display:flex; gap:2px; margin-bottom:4px; }
.tcard-stars i { color:#f59e0b; font-size:.72rem; }

/* ══ CTA ══════════════════════════════════════════════════ */
.cta-box {
    background:rgba(13,148,136,.08);
    border-radius:28px; padding:64px 48px;
    position:relative; overflow:hidden;
    border:1px solid rgba(13,148,136,.25);
}
.cta-box::before {
    content:''; position:absolute; inset:0;
    background:linear-gradient(135deg, rgba(13,148,136,.15) 0%, transparent 60%);
    pointer-events:none;
}
.cta-grid {
    position:absolute; inset:0; pointer-events:none;
    background-image:
        linear-gradient(rgba(13,148,136,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.06) 1px, transparent 1px);
    background-size:48px 48px;
}
.cta-inner { position:relative; z-index:1; text-align:center; }
.cta-inner h2 { font-size:2rem; font-weight:800; color:#fff; margin-bottom:12px; letter-spacing:-.02em; }
.cta-inner p  { color:rgba(255,255,255,.55); font-size:1rem; max-width:500px; margin:0 auto 32px; }
.cta-btns { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-bottom:44px; }
.btn-cm {
    background:#0d9488; color:#fff; font-weight:700; font-size:.9rem;
    padding:14px 32px; border-radius:12px; text-decoration:none;
    transition:background .2s, transform .15s;
}
.btn-cm:hover { background:#0f766e; color:#fff; transform:translateY(-2px); }
.btn-cg {
    background:rgba(255,255,255,.08); color:rgba(255,255,255,.85);
    border:1.5px solid rgba(255,255,255,.18); font-weight:700; font-size:.9rem;
    padding:14px 32px; border-radius:12px; text-decoration:none;
    transition:background .2s;
}
.btn-cg:hover { background:rgba(255,255,255,.14); color:#fff; }
.cta-feats { display:flex; justify-content:center; gap:16px; flex-wrap:wrap; }
.cta-feat {
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1);
    border-radius:16px; padding:24px 20px; text-align:center; width:190px;
    text-decoration:none; color:#fff; transition:background .2s;
}
.cta-feat:hover { background:rgba(255,255,255,.12); color:#fff; }
.cta-feat i { font-size:1.5rem; margin-bottom:10px; display:block; color:#0d9488; }
.cta-feat h6 { font-size:.88rem; font-weight:700; margin-bottom:5px; color:#fff; }
.cta-feat p  { font-size:.75rem; color:rgba(255,255,255,.45); margin:0; line-height:1.5; }

@@media (max-width:992px) {
    .hero-body { padding:120px 0 60px; }
    .cta-box { padding:44px 24px; }
    .trust-divider { display:none; }
}
@@media (max-width:576px) {
    .hero-title { font-size:2.2rem; }
    .gb-students { gap:6px; }
    .cta-feats { flex-direction:column; align-items:center; }
    .trust-num { font-size:1.8rem; }
}
</style>

<!-- ══════════════════════════════════════════ HERO -->
<section class="hero-pro">
    <div class="hero-bg">
        <img src="img/Health/showcase-1.webp" alt="">
    </div>
    <div class="hero-grid"></div>

    <div class="hero-body">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10 text-center text-lg-start" data-aos="fade-up" data-aos-delay="100">

                    <div class="hero-eyebrow d-inline-flex">
                        <span class="dot"></span>
                        <span>Atención médica confiable</span>
                    </div>

                    <h1 class="hero-title">
                        Cuidamos tu salud<br>
                        con atención <span class="accent">rápida</span><br>
                        y humana
                    </h1>

                    <p class="hero-sub mx-auto mx-lg-0">
                        Gestiona tus citas, accede a tu historial y conecta con especialistas fácilmente desde cualquier lugar.
                    </p>

                    <div class="d-flex gap-3 flex-wrap justify-content-center justify-content-lg-start">
                        <a href="/Home/IniciarSesion" class="btn-hm">
                            <i class="bi bi-calendar-check"></i> Agendar cita
                        </a>
                        <a href="#featured-departments" class="btn-ho">
                            Ver servicios →
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- GROUP BAR -->
    <div class="group-bar">
        <div class="container">
            <div class="gb-inner">
                <span class="gb-pill">Grupo 3</span>
                <span class="gb-course">Programación Avanzada en Web</span>
                <span class="gb-sep">·</span>
                <div class="gb-students">
                    <span class="gb-name"><i class="bi bi-person-fill"></i>Fabricio Calvo</span>
                    <span class="gb-sep">·</span>
                    <span class="gb-name"><i class="bi bi-person-fill"></i>Julian Clot</span>
                    <span class="gb-sep">·</span>
                    <span class="gb-name"><i class="bi bi-person-fill"></i>Yarling Henry</span>
                    <span class="gb-sep">·</span>
                    <span class="gb-name"><i class="bi bi-person-fill"></i>Jose Andrés Vargas</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════ TRUST BAR -->
<section class="trust-bar">
    <div class="container">
        <div class="d-flex justify-content-center align-items-center flex-wrap gap-4">
            <div class="trust-item">
                <div class="trust-num"><span class="counter" data-target="1200">0</span><span>+</span></div>
                <div class="trust-label">Pacientes atendidos</div>
            </div>
            <div class="trust-divider d-none d-md-block"></div>
            <div class="trust-item">
                <div class="trust-num"><span class="counter" data-target="15">0</span><span>+</span></div>
                <div class="trust-label">Especialistas</div>
            </div>
            <div class="trust-divider d-none d-md-block"></div>
            <div class="trust-item">
                <div class="trust-num"><span class="counter" data-target="98">0</span><span>%</span></div>
                <div class="trust-label">Satisfacción</div>
            </div>
            <div class="trust-divider d-none d-md-block"></div>
            <div class="trust-item">
                <div class="trust-num"><span class="counter" data-target="8">0</span><span></span></div>
                <div class="trust-label">Especialidades</div>
            </div>
            <div class="trust-divider d-none d-md-block"></div>
            <div class="trust-item">
                <div class="trust-num"><span class="counter" data-target="24">0</span><span>/7</span></div>
                <div class="trust-label">Disponibilidad</div>
            </div>
        </div>
    </div>
</section>

<!-- wave de trust bar → departamentos -->
<div class="wave-divider" style="background:#071428;">
    <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,0 C360,48 1080,48 1440,0 L1440,48 L0,48 Z" fill="#071428"/>
        <path d="M0,0 C360,48 1080,48 1440,0" fill="none" stroke="rgba(13,148,136,.15)" stroke-width="1.5"/>
    </svg>
</div>

<!-- ══════════════════════════════════════════ CÓMO FUNCIONA -->
<section class="sec sec-dark2" style="padding-top:60px;">
    <div class="container">
        <div class="sh" data-aos="fade-up">
            <h2>¿Cómo funciona?</h2>
            <p>Agenda tu cita en tres pasos simples, sin complicaciones</p>
            <div class="sh-bar"></div>
        </div>
        <div class="steps-wrap">
            <div class="steps-line"></div>
            <div class="row gy-5 justify-content-center">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="step-card">
                        <div class="step-num">
                            <i class="bi bi-search"></i>
                        </div>
                        <h5>Elige tu especialidad</h5>
                        <p>Explora nuestros departamentos y selecciona la especialidad que necesitas.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="step-card">
                        <div class="step-num">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <h5>Selecciona tu médico</h5>
                        <p>Revisa perfiles, calificaciones y disponibilidad para elegir al especialista ideal.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="step-card">
                        <div class="step-num">
                            <i class="bi bi-calendar2-check"></i>
                        </div>
                        <h5>Confirma tu cita</h5>
                        <p>Selecciona fecha y hora. Recibirás confirmación y recordatorio automático.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- wave de cómo funciona → departamentos -->
<div class="wave-divider" style="background:#040d1a;">
    <svg viewBox="0 0 1440 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,48 C360,0 1080,0 1440,48 L1440,0 L0,0 Z" fill="#071428"/>
        <path d="M0,48 C360,0 1080,0 1440,48" fill="none" stroke="rgba(13,148,136,.15)" stroke-width="1.5"/>
    </svg>
</div>

<!-- ══════════════════════════════════════════ DEPARTAMENTOS -->
<section id="featured-departments" class="sec sec-dark">
    <div class="container">
        <div class="sh" data-aos="fade-up">
            <h2>Departamentos destacados</h2>
            <p>Especialidades principales para tu atención y seguimiento</p>
            <div class="sh-bar"></div>
        </div>
        <div class="row gy-4">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="dc">
                    <div class="dc-img">
                        <img src="img/Health/cardiology-3.webp" alt="Cardiología">
                        <span class="dc-badge">Cardiología</span>
                    </div>
