@model Proyecto_PWA_Clinica.Models.EstadisticasPaciente

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new List<Proyecto_PWA_Clinica.Models.Cita>();
    var tratamientos = ViewBag.Tratamientos as List<Proyecto_PWA_Clinica.Models.Tratamiento> ?? new List<Proyecto_PWA_Clinica.Models.Tratamiento>();
}

<style>
body { background-color: #040d1a !important; }

.dash-page {
    min-height: 100vh;
    background: #040d1a;
    padding: 100px 0 60px;
}

/* ── HERO ── */
.dash-hero {
    position: relative;
    background: linear-gradient(135deg, rgba(13,148,136,.15) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: 40px 0 36px;
    margin-bottom: 48px;
    overflow: hidden;
}
.dash-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.05) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
}
.dash-hero-inner { position: relative; z-index: 1; }
.dash-greeting { font-size: 1.8rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
.dash-greeting span { color: #0d9488; }
.dash-sub { color: rgba(255,255,255,.45); font-size: .95rem; margin: 0; }

/* ── STAT CARDS ── */
.stat-card {
    border-radius: 20px; padding: 28px 24px;
    border: 1px solid rgba(255,255,255,.09);
    background: rgba(255,255,255,.04);
    display: flex; align-items: center; gap: 20px;
    transition: transform .25s, box-shadow .25s;
    height: 100%;
}
.stat-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,.3); }
.stat-icon {
    width: 56px; height: 56px; border-radius: 16px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
}
.stat-icon.teal   { background: rgba(13,148,136,.2);  color: #0d9488; }
.stat-icon.green  { background: rgba(34,197,94,.15);  color: #22c55e; }
.stat-icon.red    { background: rgba(239,68,68,.15);  color: #ef4444; }
.stat-icon.blue   { background: rgba(59,130,246,.15); color: #3b82f6; }
.stat-num  { font-size: 2rem; font-weight: 900; color: #fff; line-height: 1; margin-bottom: 4px; }
.stat-label { font-size: .78rem; font-weight: 600; color: rgba(255,255,255,.4); letter-spacing: .05em; text-transform: uppercase; }

/* ── DARK CARD ── */
.dark-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; overflow: hidden; height: 100%;
}
.dark-card-header {
    padding: 20px 24px 16px;
    border-bottom: 1px solid rgba(255,255,255,.06);
    display: flex; align-items: center; justify-content: space-between;
}
.dark-card-header h4 { font-size: 1rem; font-weight: 800; color: #fff; margin: 0; }
.dark-card-header h4 i { color: #0d9488; }
.dark-card-body { padding: 20px 24px; }

/* ── CITA ITEM ── */
.cita-item {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
}
.cita-item:last-child { border-bottom: none; }
.cita-especialidad { font-size: .98rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
.cita-medico { font-size: .82rem; color: rgba(255,255,255,.45); margin-bottom: 2px; }
.cita-medico i { color: #0d9488; }
.cita-motivo { font-size: .78rem; color: rgba(255,255,255,.3); }
.cita-fecha {
    background: rgba(13,148,136,.15);
    border: 1px solid rgba(13,148,136,.3);
    border-radius: 10px; padding: 6px 12px;
    text-align: center; flex-shrink: 0; margin-left: 12px;
}
.cita-fecha .date { font-size: .8rem; font-weight: 800; color: #0d9488; white-space: nowrap; }
.cita-fecha .time { font-size: .72rem; color: rgba(255,255,255,.35); }

.empty-state { text-align: center; padding: 40px 20px; }
.empty-state i { font-size: 2.5rem; color: rgba(255,255,255,.15); display: block; margin-bottom: 12px; }
.empty-state p { color: rgba(255,255,255,.3); font-size: .9rem; margin: 0; }

/* ── QUICK LINKS ── */
.quick-link {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 16px; border-radius: 14px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    text-decoration: none; color: #fff;
    transition: background .2s, border-color .2s, transform .2s;
    margin-bottom: 10px;
}
.quick-link:hover {
    background: rgba(13,148,136,.12);
    border-color: rgba(13,148,136,.35);
    color: #fff; transform: translateX(4px);
}
.quick-link-icon {
    width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
}
.quick-link-icon.teal  { background: rgba(13,148,136,.2);  color: #0d9488; }
.quick-link-icon.green { background: rgba(34,197,94,.15);  color: #22c55e; }
.quick-link span { font-size: .9rem; font-weight: 600; }
.quick-link i.bi-chevron-right { margin-left: auto; color: rgba(255,255,255,.2); font-size: .8rem; }

/* ── TRATAMIENTO CARD ── */
.trat-card {
    background: linear-gradient(135deg, rgba(13,148,136,.12) 0%, rgba(8,30,60,.4) 100%);
    border: 1px solid rgba(13,148,136,.25);
    border-radius: 16px; padding: 20px;
}
.trat-card h5 { font-size: .85rem; font-weight: 700; color: rgba(255,255,255,.5); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 12px; }
.trat-med { font-size: 1.1rem; font-weight: 800; color: #0d9488; margin-bottom: 10px; }
.trat-detail { display: flex; align-items: center; gap: 8px; font-size: .85rem; color: rgba(255,255,255,.5); margin-bottom: 6px; }
.trat-detail i { color: #0d9488; }

/* ── BTN ── */
.btn-dark-primary {
    background: #0d9488; color: #fff;
    border: none; border-radius: 10px;
    padding: 8px 18px; font-size: .82rem; font-weight: 700;
    text-decoration: none; transition: background .2s;
    display: inline-flex; align-items: center; gap: 6px;
}
.btn-dark-primary:hover { background: #0f766e; color: #fff; }
</style>

<div class="dash-page">

    <!-- HERO -->
    <div class="dash-hero">
        <div class="container dash-hero-inner">
            <div class="dash-greeting">
                Hola, <span>@ViewBag.NombreUsuario</span> 👋
            </div>
            <p class="dash-sub">Bienvenido a tu panel de salud en Clínica CR</p>
        </div>
    </div>

    <div class="container">

        <!-- STATS -->
        <div class="row g-4 mb-5" data-aos="fade-up">
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon teal"><i class="bi bi-calendar-event"></i></div>
                    <div>
                        <div class="stat-num">@Model.CitasPendientes</div>
                        <div class="stat-label">Citas Pendientes</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="stat-num">@Model.CitasCompletadas</div>
                        <div class="stat-label">Citas Completadas</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon red"><i class="bi bi-x-circle"></i></div>
                    <div>
                        <div class="stat-num">@Model.CitasCanceladas</div>
                        <div class="stat-label">Citas Canceladas</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="bi bi-capsule"></i></div>
                    <div>
                        <div class="stat-num">@Model.TotalTratamientos</div>
                        <div class="stat-label">Tratamientos</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- PRÓXIMAS CITAS -->
            <div class="col-lg-8" data-aos="fade-up" data-aos-delay="100">
                <div class="dark-card">
                    <div class="dark-card-header">
                        <h4><i class="bi bi-calendar-week me-2"></i>Tus próximas citas</h4>
                        <a asp-controller="Citas" asp-action="Create" class="btn-dark-primary">
                            <i class="bi bi-plus-lg"></i> Agendar nueva
                        </a>
                    </div>
                    <div class="dark-card-body">
                        @if (citas.Any(c => c.EstadoCita == "Pendiente"))
                        {
                            @foreach (var cita in citas.Where(c => c.EstadoCita == "Pendiente").OrderBy(c => c.FechaHora).Take(4))
                            {
                                <div class="cita-item">
                                    <div>
                                        <div class="cita-especialidad">@cita.Especialidad</div>
                                        <div class="cita-medico"><i class="bi bi-person-badge"></i> Dr. @cita.NombreMedico</div>
                                        <div class="cita-motivo"><i class="bi bi-info-circle"></i> @cita.Motivo</div>
                                    </div>
                                    <div class="cita-fecha">
                                        <div class="date">@cita.FechaHora.ToString("dd MMM yyyy")</div>
                                        <div class="time">@cita.FechaHora.ToString("HH:mm") hrs</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-calendar-x"></i>
                                <p>No tienes citas programadas próximamente.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SIDEBAR -->
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">

                <!-- Accesos rápidos -->
                <div class="dark-card mb-4">
                    <div class="dark-card-header">
                        <h4><i class="bi bi-lightning me-2"></i>Accesos rápidos</h4>
                    </div>
                    <div class="dark-card-body">
                        <a asp-controller="Citas" asp-action="Index" class="quick-link">
                            <div class="quick-link-icon teal"><i class="bi bi-list-check"></i></div>
                            <span>Mis Citas</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-controller="HistorialMedico" asp-action="Index" class="quick-link">
                            <div class="quick-link-icon green"><i class="bi bi-file-medical"></i></div>
                            <span>Mi Historial Médico</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Último tratamiento -->
                @if (tratamientos.Any())
                {
                    var ultimo = tratamientos.Last();
                    <div class="trat-card">
                        <h5><i class="bi bi-prescription2 me-2"></i>Último tratamiento</h5>
                        <div class="trat-med">@ultimo.Medicamento</div>
                        <div class="trat-detail"><i class="bi bi-droplet"></i> Dosis: @ultimo.Dosis</div>
                        <div class="trat-detail"><i class="bi bi-clock-history"></i> @ultimo.Duracion</div>
                    </div>
                }
                else
                {
                    <div class="trat-card" style="text-align:center;">
                        <i class="bi bi-shield-check" style="font-size:2rem; color:#0d9488; display:block; margin-bottom:10px;"></i>
                        <p style="color:rgba(255,255,255,.4); font-size:.88rem; margin:0;">No hay tratamientos activos.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
