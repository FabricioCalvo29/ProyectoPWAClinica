@model Proyecto_PWA_Clinica.Models.EstadisticasPaciente

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new List<Proyecto_PWA_Clinica.Models.Cita>();
    var tratamientos = ViewBag.Tratamientos as List<Proyecto_PWA_Clinica.Models.Tratamiento> ?? new List<Proyecto_PWA_Clinica.Models.Tratamiento>();
}

<!-- Hero Section -->
<section id="hero" class="hero section light-background" style="padding-top: 100px; padding-bottom: 50px;">
    <div class="container text-center">
        <h2>Hola, @ViewBag.NombreUsuario! 👋</h2>
        <p>Bienvenido a tu panel de salud en Clínica CR</p>
    </div>
</section>

<!-- Panel Section -->
<section class="section">
    <div class="container" data-aos="fade-up">

        <!-- Stat Cards -->
        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-primary text-white text-center p-4" style="border-radius: 12px; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                    <i class="bi bi-calendar-event fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1">@Model.CitasPendientes</h3>
                    <p class="mb-0 text-white-50">Citas Pendientes</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-success text-white text-center p-4" style="border-radius: 12px; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                    <i class="bi bi-check-circle fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1">@Model.CitasCompletadas</h3>
                    <p class="mb-0 text-white-50">Citas Completadas</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-danger text-white text-center p-4" style="border-radius: 12px; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                    <i class="bi bi-x-circle fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1">@Model.CitasCanceladas</h3>
                    <p class="mb-0 text-white-50">Citas Canceladas</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-info text-white text-center p-4" style="border-radius: 12px; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                    <i class="bi bi-capsule fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1">@Model.TotalTratamientos</h3>
                    <p class="mb-0 text-white-50">Tratamientos Recetados</p>
                </div>
            </div>
        </div>

        <div class="row gx-5">
            <!-- Columna Próximas Citas -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold text-dark"><i class="bi bi-calendar-week me-2 text-primary"></i> Tus Próximas Citas</h4>
                        <a asp-controller="Citas" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 shadow">Agendar Nueva</a>
                    </div>
                    <div class="card-body">
                        @if (citas.Any(c => c.EstadoCita == "Pendiente"))
                        {
                            <ul class="list-group list-group-flush mt-3">
                                @foreach (var cita in citas.Where(c => c.EstadoCita == "Pendiente").OrderBy(c => c.FechaHora).Take(4))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start py-3 border-bottom border-light">
                                        <div class="ms-2 me-auto">
                                            <div class="fw-bold fs-5">@cita.Especialidad</div>
                                            <span class="text-muted"><i class="bi bi-person-badge"></i> Dr. @cita.NombreMedico</span><br/>
                                            <small class="text-secondary"><i class="bi bi-info-circle"></i> @cita.Motivo</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-primary fs-6 rounded-pill">@cita.FechaHora.ToString("dd MMM yyyy")</span><br/>
                                            <span class="text-muted small">@cita.FechaHora.ToString("HH:mm") hrs</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center p-5">
                                <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                                <span class="text-muted">No tienes citas programadas próximamente.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Columna Accesos Rápidos -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4 bg-light" style="border-radius: 12px;">
                    <div class="card-body p-4 text-center">
                        <h4 class="fw-bold text-dark mb-4">Accesos Rápidos</h4>
                        <div class="d-grid gap-3">
                            <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill border-2">
                                <i class="bi bi-list-check me-2"></i> Mis Citas
                            </a>
                            <a asp-controller="HistorialMedico" asp-action="Index" class="btn btn-outline-success btn-lg rounded-pill border-2">
                                <i class="bi bi-file-medical me-2"></i> Mi Historial Médico
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Último Tratamiento Card -->
                @if (tratamientos.Any())
                {
                    <div class="card border-0 shadow-sm" style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-dark"><i class="bi bi-prescription2 text-info me-2"></i> Último Tratamiento</h5>
                            @{
                                var ultimo = tratamientos.Last();
                            }
                            <h6 class="fs-5 mt-3 text-primary fw-bold">@ultimo.Medicamento</h6>
                            <p class="mb-1 text-secondary"><i class="bi bi-droplet"></i> Dosis: @ultimo.Dosis</p>
                            <p class="mb-1 text-secondary"><i class="bi bi-clock-history"></i> @ultimo.Duracion</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm" style="border-radius: 12px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                        <div class="card-body p-4 text-center text-muted">
                            <i class="bi bi-shield-check fs-1 text-success mb-2 d-block"></i>
                            <p class="mb-0">No hay tratamientos activos.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>