@model Proyecto_PWA_Clinica.Models.Usuario

@{
    Layout = "_Layout";
    ViewData["Title"] = "Registro de paciente";
}

<style>
    .registro-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #f0fdf4 100%);
        padding: 80px 16px 40px;
    }

    .registro-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,.10);
        overflow: hidden;
        max-width: 680px;
        margin: 0 auto;
    }

    .registro-header {
        background: linear-gradient(135deg, #0d9488 0%, #0891b2 100%);
        padding: 36px 40px 28px;
        text-align: center;
        color: #fff;
    }

    .registro-header .icon-circle {
        width: 64px; height: 64px;
        background: rgba(255,255,255,.18);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 14px;
        font-size: 1.8rem;
    }

    .registro-header h1 {
        font-size: 1.7rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .registro-header p {
        opacity: .88;
        font-size: .95rem;
        margin: 0;
    }

    .registro-body {
        padding: 36px 40px 40px;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 28px 0 20px;
    }

    .section-divider span {
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #0d9488;
        white-space: nowrap;
    }

    .section-divider::before,
    .section-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e5e7eb;
    }

    .form-label {
        font-weight: 600;
        font-size: .875rem;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d9488;
        box-shadow: 0 0 0 3px rgba(13,148,136,.12);
        outline: none;
    }

    .input-icon-wrapper {
        position: relative;
    }

    .input-icon-wrapper .bi {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 1rem;
        pointer-events: none;
    }

    .input-icon-wrapper .form-control,
    .input-icon-wrapper .form-select {
        padding-left: 38px;
    }

    .btn-registro {
        background: linear-gradient(135deg, #0d9488, #0891b2);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 13px 28px;
        font-size: 1rem;
        font-weight: 600;
        width: 100%;
        transition: opacity .2s, transform .15s;
    }

    .btn-registro:hover {
        opacity: .92;
        transform: translateY(-1px);
        color: #fff;
    }

    .alert-danger-custom {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 14px 16px;
        color: #b91c1c;
        font-size: .9rem;
    }

    .alert-success-custom {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 10px;
        padding: 14px 16px;
        color: #15803d;
        font-size: .9rem;
    }

    @@media (max-width: 576px) {
        .registro-body { padding: 24px 20px 28px; }
        .registro-header { padding: 28px 20px 22px; }
    }
</style>

<div class="registro-wrapper">
    <div class="registro-card">
        <div class="registro-header">
            <div class="icon-circle">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h1>Crear cuenta</h1>
            <p>Completa el formulario para acceder al portal de pacientes</p>
        </div>

        <div class="registro-body">
            <form asp-action="Registro" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()

                @if (ViewBag.MensajeExito != null)
                {
                    <div class="alert-success-custom mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i>@ViewBag.MensajeExito
                    </div>
                }

                @if (ViewBag.MensajeErrorApi != null)
                {
                    <div class="alert-danger-custom mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.MensajeErrorApi
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert-danger-custom mb-3"></div>

                <!-- DATOS PERSONALES -->
                <div class="section-divider"><span>Datos personales</span></div>

                <div class="row g-3">
                    <div class="col-md-6 mb-1">
                        <label asp-for="Nombre" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-person"></i>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-1">
                        <label asp-for="Apellido" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-person"></i>
                            <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" />
                        </div>
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-0">
                    <div class="col-md-6 mb-1">
                        <label asp-for="Cedula" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-card-text"></i>
                            <input asp-for="Cedula" class="form-control" placeholder="Ej. 1-0000-0000" />
                        </div>
                        <span asp-validation-for="Cedula" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-1">
                        <label asp-for="FechaNacimiento" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-calendar3"></i>
                            <input asp-for="FechaNacimiento" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-0">
                    <div class="col-md-6 mb-1">
                        <label asp-for="Telefono" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej. 8888-8888" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-1">
                        <label asp-for="TipoSangre" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-droplet-half"></i>
                            <select asp-for="TipoSangre" class="form-select">
                                <option value="">Seleccione</option>
                                <option>A+</option>
                                <option>A-</option>
                                <option>B+</option>
                                <option>B-</option>
                                <option>AB+</option>
                                <option>AB-</option>
                                <option>O+</option>
                                <option>O-</option>
                            </select>
                        </div>
                        <span asp-validation-for="TipoSangre" class="text-danger small"></span>
                    </div>
                </div>

                <!-- CUENTA -->
                <div class="section-divider"><span>Datos de acceso</span></div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <div class="input-icon-wrapper">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Correo" class="form-control" placeholder="correo@ejemplo.com" />
                    </div>
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-1">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Contrasena" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-1">
                        <label asp-for="ConfirmarContrasena" class="form-label"></label>
                        <div class="input-icon-wrapper">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ConfirmarContrasena" type="password" class="form-control" placeholder="Repite la contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>
                </div>

                <!-- HISTORIAL -->
                <div class="section-divider"><span>Información médica (opcional)</span></div>

                <div class="mb-4">
                    <label asp-for="HistorialMedico" class="form-label"></label>
                    <textarea asp-for="HistorialMedico" class="form-control" rows="3"
                              placeholder="Alergias, enfermedades crónicas, medicamentos actuales..."></textarea>
                    <span asp-validation-for="HistorialMedico" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-registro">
                    <i class="bi bi-person-check-fill me-2"></i>Crear cuenta
                </button>

                <div class="text-center mt-4">
                    <p class="mb-0 text-muted" style="font-size:.9rem;">
                        ¿Ya tienes cuenta?
                        <a asp-controller="Home" asp-action="IniciarSesion" style="color:#0d9488; font-weight:600;">
                            Inicia sesión aquí
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
