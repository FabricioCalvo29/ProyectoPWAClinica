@model Proyecto_PWA_Clinica.Models.EstadisticasAdmin

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new List<Proyecto_PWA_Clinica.Models.Cita>();
}

<!-- Hero Section -->
<section id="hero" class="hero section bg-dark text-white" style="padding-top: 100px; padding-bottom: 50px;">
    <div class="container text-center">
        <h2>Panel de Administración 🛡️</h2>
        <p class="text-white-50">Bienvenido, @ViewBag.NombreUsuario. Sistema de Control General.</p>
    </div>
</section>

<!-- Panel Section -->
<section class="section bg-light min-vh-100">
    <div class="container" data-aos="fade-up">

        <!-- Stat Cards -->
        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 12px; border-bottom: 5px solid #0d6efd !important;">
                    <i class="bi bi-people-fill text-primary fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.TotalUsuarios</h3>
                    <p class="mb-0 text-secondary fw-bold">Usuarios Totales</p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 12px; border-bottom: 5px solid #ffc107 !important;">
                    <i class="bi bi-hourglass-split text-warning fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasPendientes</h3>
                    <p class="mb-0 text-secondary fw-bold">Citas por Atender</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 12px; border-bottom: 5px solid #198754 !important;">
                    <i class="bi bi-check-all text-success fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasCompletadas</h3>
                    <p class="mb-0 text-secondary fw-bold">Reuniones Exitosas</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 12px; border-bottom: 5px solid #0dcaf0 !important;">
                    <i class="bi bi-calendar-day text-info fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasHoy</h3>
                    <p class="mb-0 text-secondary fw-bold">Citas Para Hoy</p>
                </div>
            </div>
        </div>

        <div class="row gx-5">
            <!-- Citas del Día -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold text-dark"><i class="bi bi-table me-2 text-danger"></i> Monitor de Citas</h4>
                        <a href="#" class="btn btn-outline-dark btn-sm rounded-pill px-4">Ver Todo</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle line-height-lg">
                                <thead class="table-light text-secondary">
                                    <tr>
                                        <th>Fecha Hora</th>
                                        <th>Paciente</th>
                                        <th>Médico Asignado</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in citas.OrderBy(c => c.FechaHora).Take(6))
                                    {
                                        <tr>
                                            <td><strong>@cita.FechaHora.ToString("dd/MM HH:mm")</strong></td>
                                            <td><i class="bi bi-person text-muted me-1"></i> Paciente ID: @cita.IdPaciente</td>
                                            <td>Dr. @cita.NombreMedico</td>
                                            <td>
                                                @if(cita.EstadoCita == "Pendiente") { <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@cita.EstadoCita</span> }
                                                @if(cita.EstadoCita == "Completada") { <span class="badge bg-success px-3 py-2 rounded-pill">@cita.EstadoCita</span> }
                                                @if(cita.EstadoCita == "Cancelada") { <span class="badge bg-danger px-3 py-2 rounded-pill">@cita.EstadoCita</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Accesos Admin -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Panel Operativo</h5>
                        <div class="list-group list-group-flush rounded border-0">
                            <a asp-controller="Pacientes" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                                <i class="bi bi-people fs-4 text-primary me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Gestionar Pacientes</h6>
                                    <small class="text-muted">Añadir, ver historial o dar de baja.</small>
                                </div>
                            </a>
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                                <i class="bi bi-heart-pulse fs-4 text-danger me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Directorio Médico</h6>
                                    <small class="text-muted">Personal de la clínica.</small>
                                </div>
                            </a>
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0">
                                <i class="bi bi-gear fs-4 text-dark me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Configuración Global</h6>
                                    <small class="text-muted">Servidor y cuentas de usuario.</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>