@model Proyecto_PWA_Clinica.Models.EstadisticasAdmin

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new List<Proyecto_PWA_Clinica.Models.Cita>();
}

<style>
body { background-color: #040d1a !important; }

.page-wrap {
    min-height: 100vh;
    background: #040d1a;
    padding: 100px 0 60px;
    position: relative;
}
.page-wrap::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
}

/* ── hero strip ── */
.dash-hero {
    position: relative; z-index: 1;
    margin-bottom: 36px;
}
.dash-hero h1 {
    font-size: 1.7rem; font-weight: 800; color: #fff; margin-bottom: 4px;
}
.dash-hero p { color: rgba(255,255,255,.4); font-size: .93rem; margin: 0; }
.dash-hero .shield-icon {
    width: 52px; height: 52px; border-radius: 16px;
    background: rgba(13,148,136,.15); border: 1.5px solid rgba(13,148,136,.35);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #0d9488; margin-bottom: 16px;
}

/* ── stat cards ── */
.stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px; margin-bottom: 32px; position: relative; z-index: 1;
}
.stat-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; padding: 22px 22px;
    display: flex; align-items: center; gap: 16px;
    transition: border-color .2s, background .2s;
}
.stat-card:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.14); }
.stat-card .s-icon {
    width: 48px; height: 48px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem; flex-shrink: 0;
}
.s-blue  .s-icon { background: rgba(99,102,241,.15); color: #818cf8; border: 1px solid rgba(99,102,241,.25); }
.s-amber .s-icon { background: rgba(245,158,11,.15); color: #f59e0b; border: 1px solid rgba(245,158,11,.25); }
.s-green .s-icon { background: rgba(16,185,129,.15); color: #10b981; border: 1px solid rgba(16,185,129,.25); }
.s-teal  .s-icon { background: rgba(13,148,136,.15); color: #0d9488; border: 1px solid rgba(13,148,136,.25); }
.s-num { font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1; }
.s-lbl { font-size: .72rem; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .05em; margin-top: 3px; }

/* ── generic dark card ── */
.dark-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 24px; overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,.3);
    position: relative; z-index: 1;
}
.dark-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 18px 26px;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
.dark-card-header .ch-left {
    display: flex; align-items: center; gap: 12px;
}
.dark-card-header .ch-icon {
    width: 38px; height: 38px; border-radius: 11px;
    background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: .95rem; color: #0d9488;
}
.dark-card-header .ch-title {
    font-size: .97rem; font-weight: 700; color: #fff;
}

/* ── table ── */
.dark-table { width: 100%; border-collapse: collapse; }
.dark-table thead tr {
    background: rgba(255,255,255,.04);
    border-bottom: 1px solid rgba(255,255,255,.07);
}
.dark-table thead th {
    padding: 12px 18px;
    font-size: .68rem; font-weight: 700;
    color: rgba(255,255,255,.35);
    text-transform: uppercase; letter-spacing: .07em;
    white-space: nowrap;
}
.dark-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,.04);
    transition: background .15s;
}
.dark-table tbody tr:hover { background: rgba(13,148,136,.05); }
.dark-table tbody tr:last-child { border-bottom: none; }
.dark-table td {
    padding: 13px 18px;
    color: rgba(255,255,255,.7);
    font-size: .87rem; vertical-align: middle;
}
.dark-table td .main-text { color: #fff; font-weight: 600; }
.dark-table td .sub-text  { color: rgba(255,255,255,.3); font-size: .77rem; margin-top: 1px; }

/* ── badges ── */
.sbadge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .72rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; border-radius: 7px; padding: 3px 9px;
}
.sbadge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.sbadge.pend { background:rgba(245,158,11,.12); color:#f59e0b; border:1px solid rgba(245,158,11,.25); }
.sbadge.comp { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.sbadge.canc { background:rgba(239,68,68,.12);  color:#ef4444; border:1px solid rgba(239,68,68,.25); }

/* ── sidebar panel operativo ── */
.op-item {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255,255,255,.06);
    color: rgba(255,255,255,.7); text-decoration: none;
    transition: background .15s, color .15s;
    border-radius: 0;
}
.op-item:first-child { border-radius: 0; }
.op-item:last-child  { border-bottom: none; }
.op-item:hover { background: rgba(13,148,136,.07); color: #fff; }
.op-item .op-icon {
    width: 38px; height: 38px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem; flex-shrink: 0;
}
.op-item h6  { font-size: .87rem; font-weight: 700; color: inherit; margin: 0; }
.op-item small { font-size: .75rem; color: rgba(255,255,255,.3); }

/* ── resumen list ── */
.res-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,.06);
    font-size: .87rem;
}
.res-row:last-child { border-bottom: none; }
.res-row .res-label { color: rgba(255,255,255,.4); }
.res-row .res-value { color: #fff; font-weight: 700; }

/* ── empty ── */
.empty-inline {
    padding: 50px 20px; text-align: center;
    color: rgba(255,255,255,.3); font-size: .87rem;
}
.empty-inline i { display: block; font-size: 2rem; margin-bottom: 10px; color: rgba(255,255,255,.15); }

/* ── btn ghost ── */
.btn-ghost-sm {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; color: rgba(255,255,255,.5);
    border: 1.5px solid rgba(255,255,255,.15); border-radius: 10px;
    padding: 7px 16px; font-size: .82rem; font-weight: 600;
    cursor: pointer; transition: border-color .2s, color .2s; text-decoration: none;
}
.btn-ghost-sm:hover { border-color: rgba(255,255,255,.35); color: #fff; }
</style>

<div class="page-wrap">
    <div class="container-xl" style="max-width:1200px;">

        <!-- Hero -->
        <div class="dash-hero" data-aos="fade-down">
            <div class="shield-icon"><i class="bi bi-shield-check"></i></div>
            <h1>Panel de Administración</h1>
            <p>Bienvenido, <strong style="color:rgba(255,255,255,.7);">@ViewBag.NombreUsuario</strong>. Control general del sistema clínico.</p>
        </div>

        <!-- Stats -->
        <div class="stats-row" data-aos="fade-up" data-aos-delay="50">
            <div class="stat-card s-blue">
                <div class="s-icon"><i class="bi bi-people-fill"></i></div>
                <div><div class="s-num">@Model.TotalUsuarios</div><div class="s-lbl">Usuarios totales</div></div>
            </div>
            <div class="stat-card s-amber">
                <div class="s-icon"><i class="bi bi-hourglass-split"></i></div>
                <div><div class="s-num">@Model.CitasPendientes</div><div class="s-lbl">Citas pendientes</div></div>
            </div>
            <div class="stat-card s-green">
                <div class="s-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div><div class="s-num">@Model.CitasCompletadas</div><div class="s-lbl">Citas completadas</div></div>
            </div>
            <div class="stat-card s-teal">
                <div class="s-icon"><i class="bi bi-calendar-day-fill"></i></div>
                <div><div class="s-num">@Model.CitasHoy</div><div class="s-lbl">Citas de hoy</div></div>
            </div>
        </div>

        <!-- Main grid -->
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">

            <!-- Monitor de citas -->
            <div class="col-lg-8">
                <div class="dark-card h-100">
                    <div class="dark-card-header">
                        <div class="ch-left">
                            <div class="ch-icon"><i class="bi bi-clipboard2-pulse"></i></div>
                            <span class="ch-title">Monitor General de Citas</span>
                        </div>
                        <a asp-controller="Citas" asp-action="AdminIndex" class="btn-ghost-sm">
                            Ver todas <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    @if (citas.Any())
                    {
                        <div class="table-responsive">
                            <table class="dark-table">
                                <thead>
                                    <tr>
                                        <th>Fecha y hora</th>
                                        <th>Paciente</th>
                                        <th>Médico</th>
                                        <th>Motivo</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in citas.OrderByDescending(c => c.FechaHora).Take(8))
                                    {
                                        <tr>
                                            <td>
                                                <div class="main-text">@cita.FechaHora.ToString("dd MMM yyyy")</div>
                                                <div class="sub-text">@cita.FechaHora.ToString("HH:mm")</div>
                                            </td>
                                            <td><span style="color:rgba(255,255,255,.5);">Paciente</span> <span class="main-text">@cita.IdPaciente</span></td>
                                            <td>
                                                <div class="main-text">Dr. @cita.NombreMedico</div>
                                                <div class="sub-text">@cita.Especialidad</div>
                                            </td>
                                            <td style="max-width:130px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@cita.Motivo</td>
                                            <td>
                                                @if (cita.EstadoCita == "Pendiente")   { <span class="sbadge pend">Pendiente</span> }
                                                else if (cita.EstadoCita == "Completada") { <span class="sbadge comp">Completada</span> }
                                                else { <span class="sbadge canc">@cita.EstadoCita</span> }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-inline">
                            <i class="bi bi-calendar-x"></i>
                            No hay citas registradas en este momento.
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4 d-flex flex-column gap-4">

                <!-- Panel operativo -->
                <div class="dark-card">
                    <div class="dark-card-header">
                        <div class="ch-left">
                            <div class="ch-icon"><i class="bi bi-grid-1x2"></i></div>
                            <span class="ch-title">Panel Operativo</span>
                        </div>
                    </div>
                    <div>
                        <a asp-controller="Medicos" asp-action="Index" class="op-item">
                            <div class="op-icon" style="background:rgba(239,68,68,.12); color:#f87171; border:1px solid rgba(239,68,68,.2);"><i class="bi bi-heart-pulse"></i></div>
                            <div>
                                <h6>Gestionar Médicos</h6>
                                <small>Registrar, editar y activar/inactivar médicos.</small>
                            </div>
                        </a>
                        <a asp-controller="Pacientes" asp-action="Index" class="op-item">
                            <div class="op-icon" style="background:rgba(99,102,241,.12); color:#818cf8; border:1px solid rgba(99,102,241,.2);"><i class="bi bi-people"></i></div>
                            <div>
                                <h6>Gestionar Pacientes</h6>
                                <small>Consultar pacientes, datos e historial.</small>
                            </div>
                        </a>
                        <a asp-controller="Citas" asp-action="AdminIndex" class="op-item">
                            <div class="op-icon" style="background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.2);"><i class="bi bi-calendar-check"></i></div>
                            <div>
                                <h6>Gestionar Citas</h6>
                                <small>Visualizar y supervisar todas las citas.</small>
                            </div>
                        </a>
                        <a href="#" class="op-item">
                            <div class="op-icon" style="background:rgba(255,255,255,.06); color:rgba(255,255,255,.4); border:1px solid rgba(255,255,255,.1);"><i class="bi bi-gear"></i></div>
                            <div>
                                <h6>Configuración</h6>
                                <small>Módulos administrativos próximamente.</small>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Resumen -->
                <div class="dark-card">
                    <div class="dark-card-header">
                        <div class="ch-left">
                            <div class="ch-icon"><i class="bi bi-bar-chart-line"></i></div>
                            <span class="ch-title">Resumen Administrativo</span>
                        </div>
                    </div>
                    <div style="padding: 18px 22px;">
                        <div class="res-row"><span class="res-label">Usuarios registrados</span><span class="res-value">@Model.TotalUsuarios</span></div>
                        <div class="res-row"><span class="res-label">Citas pendientes</span><span class="res-value">@Model.CitasPendientes</span></div>
                        <div class="res-row"><span class="res-label">Citas completadas</span><span class="res-value">@Model.CitasCompletadas</span></div>
                        <div class="res-row"><span class="res-label">Citas para hoy</span><span class="res-value">@Model.CitasHoy</span></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
