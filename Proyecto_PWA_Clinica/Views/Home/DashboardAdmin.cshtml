@model Proyecto_PWA_Clinica.Models.EstadisticasAdmin

@{
    Layout = "_Layout";
    var citas = ViewBag.Citas as List<Proyecto_PWA_Clinica.Models.Cita> ?? new List<Proyecto_PWA_Clinica.Models.Cita>();
}

<section class="hero section bg-dark text-white" style="padding-top: 100px; padding-bottom: 50px;">
    <div class="container text-center">
        <h2>Panel de Administración 🛡️</h2>
        <p class="text-white-50">Bienvenido, @ViewBag.NombreUsuario. Control general del sistema clínico.</p>
    </div>
</section>

<section class="section bg-light min-vh-100">
    <div class="container" data-aos="fade-up">

        <div class="row g-4 mb-5">
            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 14px; border-bottom: 5px solid #0d6efd !important;">
                    <i class="bi bi-people-fill text-primary fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.TotalUsuarios</h3>
                    <p class="mb-0 text-secondary fw-bold">Usuarios Totales</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 14px; border-bottom: 5px solid #ffc107 !important;">
                    <i class="bi bi-hourglass-split text-warning fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasPendientes</h3>
                    <p class="mb-0 text-secondary fw-bold">Citas Pendientes</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 14px; border-bottom: 5px solid #198754 !important;">
                    <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasCompletadas</h3>
                    <p class="mb-0 text-secondary fw-bold">Citas Completadas</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card shadow-sm border-0 bg-white text-center p-4 h-100" style="border-radius: 14px; border-bottom: 5px solid #0dcaf0 !important;">
                    <i class="bi bi-calendar-day-fill text-info fs-1 mb-2"></i>
                    <h3 class="fw-bold fs-2 mb-1 text-dark">@Model.CitasHoy</h3>
                    <p class="mb-0 text-secondary fw-bold">Citas de Hoy</p>
                </div>
            </div>
        </div>

        <div class="row gx-5">
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: 14px;">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold text-dark mb-0">
                            <i class="bi bi-clipboard2-pulse me-2 text-danger"></i> Monitor General de Citas
                        </h4>
                        <a asp-controller="Citas" asp-action="AdminIndex" class="btn btn-outline-dark btn-sm rounded-pill px-4">
                            Ver Todas
                        </a>
                    </div>

                    <div class="card-body">
                        @if (citas.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light text-secondary">
                                        <tr>
                                            <th>Fecha y Hora</th>
                                            <th>Paciente</th>
                                            <th>Médico</th>
                                            <th>Motivo</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cita in citas.OrderByDescending(c => c.FechaHora).Take(8))
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@cita.FechaHora.ToString("dd/MM/yyyy")</strong><br />
                                                    <small class="text-muted">@cita.FechaHora.ToString("HH:mm")</small>
                                                </td>
                                                <td>Paciente ID: @cita.IdPaciente</td>
                                                <td>Dr. @cita.NombreMedico</td>
                                                <td>@cita.Motivo</td>
                                                <td>
                                                    @if (cita.EstadoCita == "Pendiente")
                                                    {
                                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@cita.EstadoCita</span>
                                                    }
                                                    else if (cita.EstadoCita == "Completada")
                                                    {
                                                        <span class="badge bg-success px-3 py-2 rounded-pill">@cita.EstadoCita</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger px-3 py-2 rounded-pill">@cita.EstadoCita</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                No hay citas registradas en este momento.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Panel Operativo</h5>

                        <div class="list-group list-group-flush rounded border-0">
                            <a asp-controller="Medicos" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                                <i class="bi bi-heart-pulse fs-4 text-danger me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Gestionar Médicos</h6>
                                    <small class="text-muted">Registrar, editar y activar/inactivar médicos.</small>
                                </div>
                            </a>

                            <a asp-controller="Pacientes" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                                <i class="bi bi-people fs-4 text-primary me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Gestionar Pacientes</h6>
                                    <small class="text-muted">Consultar pacientes, datos básicos e historial.</small>
                                </div>
                            </a>

                            <a asp-controller="Citas" asp-action="AdminIndex" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                                <i class="bi bi-calendar-check fs-4 text-success me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Gestionar Citas</h6>
                                    <small class="text-muted">Visualizar y supervisar todas las citas del sistema.</small>
                                </div>
                            </a>

                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0">
                                <i class="bi bi-gear fs-4 text-dark me-3"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold">Configuración del Sistema</h6>
                                    <small class="text-muted">Módulos administrativos adicionales próximamente.</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm" style="border-radius: 14px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3">Resumen Administrativo</h5>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-3 d-flex justify-content-between">
                                <span class="text-muted">Usuarios registrados</span>
                                <strong>@Model.TotalUsuarios</strong>
                            </li>
                            <li class="mb-3 d-flex justify-content-between">
                                <span class="text-muted">Citas pendientes</span>
                                <strong>@Model.CitasPendientes</strong>
                            </li>
                            <li class="mb-3 d-flex justify-content-between">
                                <span class="text-muted">Citas completadas</span>
                                <strong>@Model.CitasCompletadas</strong>
                            </li>
                            <li class="d-flex justify-content-between">
                                <span class="text-muted">Citas para hoy</span>
                                <strong>@Model.CitasHoy</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>