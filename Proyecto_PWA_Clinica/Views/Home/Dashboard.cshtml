@{
    Layout = "_Layout";
}

<div class="container mt-5 pt-5">
    <div class="card shadow p-4">
        <h1 class="mb-3">Dashboard</h1>

        <p><strong>Bienvenido:</strong> @ViewBag.NombreUsuario</p>
        <p><strong>Correo:</strong> @ViewBag.CorreoUsuario</p>

        <hr />

        <p>Has iniciado sesión correctamente en el sistema.</p>

        <a asp-controller="Home" asp-action="CerrarSesion" class="btn btn-danger">
            Cerrar sesión
        </a>
    </div>
</div>