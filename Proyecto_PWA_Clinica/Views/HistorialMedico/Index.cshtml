@model IEnumerable<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
    var tratamientos = ViewBag.Tratamientos as List<Proyecto_PWA_Clinica.Models.Tratamiento> ?? new List<Proyecto_PWA_Clinica.Models.Tratamiento>();
}

<style>
body { background-color: #040d1a !important; }

.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px;
}

/* ── HEADER ── */
.page-header {
    background: linear-gradient(135deg, rgba(13,148,136,.15) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: 40px 0 36px; margin-bottom: 48px;
    position: relative; overflow: hidden; text-align: center;
}
.page-header::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.05) 1px, transparent 1px);
    background-size: 48px 48px; pointer-events: none;
}
.page-header-inner { position: relative; z-index: 1; }
.header-icon-big {
    width: 64px; height: 64px; border-radius: 20px;
    background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; color: #0d9488;
    margin: 0 auto 20px;
}
.page-title { font-size: 1.9rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
.page-sub   { color: rgba(255,255,255,.4); font-size: .95rem; margin: 0; }

/* ── TIMELINE CARD ── */
.hx-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; overflow: hidden; margin-bottom: 20px;
    transition: transform .25s, box-shadow .25s;
}
.hx-card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,.3); }

.hx-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.18) 0%, rgba(8,30,60,.4) 100%);
    border-bottom: 1px solid rgba(13,148,136,.15);
    padding: 18px 24px;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
}
.hx-date { font-size: 1rem; font-weight: 800; color: #fff; }
.hx-date i { color: #0d9488; }
.hx-time { font-size: .78rem; color: rgba(255,255,255,.35); margin-top: 2px; }
.hx-badge-done {
    background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.3);
    color: #4ade80; border-radius: 50px;
    font-size: .7rem; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; padding: 5px 14px;
}

.hx-card-body { padding: 24px; }

.hx-section-title {
    font-size: .7rem; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: rgba(255,255,255,.35);
    margin-bottom: 14px;
}
.hx-detail {
    display: flex; align-items: center; gap: 10px;
    font-size: .88rem; color: rgba(255,255,255,.6);
    margin-bottom: 8px;
}
.hx-detail i { color: #0d9488; width: 16px; }
.hx-detail strong { color: #fff; }

.divider-v {
    width: 1px; background: rgba(255,255,255,.06);
    align-self: stretch; margin: 0 8px;
}

/* ── TRATAMIENTO PILL ── */
.trat-box {
    background: rgba(13,148,136,.08);
    border: 1px solid rgba(13,148,136,.2);
    border-radius: 14px; padding: 16px 18px; margin-bottom: 10px;
}
.trat-box:last-child { margin-bottom: 0; }
.trat-med { font-size: .95rem; font-weight: 800; color: #0d9488; margin-bottom: 8px; }
.trat-med i { margin-right: 6px; }
.trat-row { font-size: .82rem; color: rgba(255,255,255,.5); margin-bottom: 4px; }
.trat-row strong { color: rgba(255,255,255,.75); }
.trat-instrucciones {
    margin-top: 10px; padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,.06);
    font-size: .8rem; color: rgba(255,255,255,.4); line-height: 1.6;
}

.no-trat {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 12px; padding: 16px 18px;
    font-size: .87rem; color: rgba(255,255,255,.3);
    display: flex; align-items: center; gap: 10px;
}

/* ── EMPTY ── */
.empty-state {
    text-align: center; padding: 72px 24px;
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 20px;
}
.empty-state i { font-size: 3rem; color: rgba(255,255,255,.1); display: block; margin-bottom: 16px; }
.empty-state h4 { color: rgba(255,255,255,.35); font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }
.empty-state p  { color: rgba(255,255,255,.2); font-size: .9rem; margin-bottom: 28px; }

.btn-primary-dark {
    display: inline-flex; align-items: center; gap: 8px;
    background: #0d9488; color: #fff; border: none; border-radius: 12px;
    padding: 12px 24px; font-size: .9rem; font-weight: 700;
    text-decoration: none; transition: background .2s, transform .15s;
}
.btn-primary-dark:hover { background: #0f766e; color: #fff; transform: translateY(-1px); }
</style>

<div class="page-wrap">

    <!-- HEADER -->
    <div class="page-header">
        <div class="container page-header-inner">
            <div class="header-icon-big"><i class="bi bi-journal-medical"></i></div>
            <div class="page-title">Mi Historial Médico</div>
            <p class="page-sub">Consulta el detalle de tus citas pasadas y los tratamientos recibidos</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                @if (!Model.Any())
                {
                    <div class="empty-state" data-aos="fade-up">
                        <i class="bi bi-box-seam"></i>
                        <h4>Aún no tienes historial médico</h4>
                        <p>Tus citas completadas y tratamientos aparecerán aquí.</p>
                        <a asp-controller="Citas" asp-action="Create" class="btn-primary-dark">
                            <i class="bi bi-calendar-plus"></i> Agendar una cita
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var cita in Model.OrderByDescending(c => c.FechaHora))
                    {
                        var tratamientosCita = tratamientos.Where(t => t.IdCita == cita.IdCita).ToList();

                        <div class="hx-card" data-aos="fade-up">
                            <div class="hx-card-header">
                                <div>
                                    <div class="hx-date">
                                        <i class="bi bi-calendar-check me-2"></i>
                                        @cita.FechaHora.ToString("dd MMMM yyyy")
                                    </div>
                                    <div class="hx-time">@cita.FechaHora.ToString("HH:mm") hrs</div>
                                </div>
                                <span class="hx-badge-done"><i class="bi bi-check-circle me-1"></i>Completada</span>
                            </div>

                            <div class="hx-card-body">
                                <div class="row g-4">
                                    <!-- DETALLES -->
                                    <div class="col-md-5">
                                        <div class="hx-section-title">Detalles de la cita</div>
                                        <div class="hx-detail">
                                            <i class="bi bi-person-badge"></i>
                                            <span><strong>Dr. @cita.NombreMedico</strong></span>
                                        </div>
                                        <div class="hx-detail">
                                            <i class="bi bi-heart-pulse"></i>
                                            <span>@cita.Especialidad</span>
                                        </div>
                                        <div class="hx-detail">
                                            <i class="bi bi-card-text"></i>
                                            <span>@cita.Motivo</span>
                                        </div>
                                    </div>

                                    <div class="divider-v d-none d-md-block"></div>

                                    <!-- TRATAMIENTOS -->
                                    <div class="col-md-6">
                                        <div class="hx-section-title">Tratamiento recetado</div>

                                        @if (tratamientosCita.Any())
                                        {
                                            @foreach (var trat in tratamientosCita)
                                            {
                                                <div class="trat-box">
                                                    <div class="trat-med"><i class="bi bi-capsule"></i>@trat.Medicamento</div>
                                                    <div class="trat-row"><strong>Dosis:</strong> @trat.Dosis</div>
                                                    <div class="trat-row"><strong>Duración:</strong> @trat.Duracion</div>
                                                    @if (!string.IsNullOrEmpty(trat.Instrucciones))
                                                    {
                                                        <div class="trat-instrucciones">
                                                            <i class="bi bi-info-circle me-1"></i>@trat.Instrucciones
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="no-trat">
                                                <i class="bi bi-info-circle" style="color:#0d9488; font-size:1.1rem;"></i>
                                                No se registraron medicamentos o tratamientos en esta visita.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
</div>
