@model IEnumerable<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
    var tratamientos = ViewBag.Tratamientos as List<Proyecto_PWA_Clinica.Models.Tratamiento> ?? new List<Proyecto_PWA_Clinica.Models.Tratamiento>();
}

<!-- Hero Section -->
<section class="hero section bg-light text-dark text-center" style="padding-top: 100px; padding-bottom: 50px; background: linear-gradient(180deg, rgba(235,244,255,1) 0%, rgba(255,255,255,1) 100%);">
    <div class="container">
        <i class="bi bi-journal-medical fs-1 text-primary mb-3"></i>
        <h2 class="fw-bold fs-1">Mi Historial Médico</h2>
        <p class="text-secondary">Consulta el detalle de tus citas pasadas y los tratamientos recibidos.</p>
    </div>
</section>

<!-- Timeline Section -->
<section class="section py-4">
    <div class="container">
        
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam text-muted fs-1 mb-3 d-block"></i>
                <h4 class="text-muted">Aún no tienes historial médico</h4>
                <p class="text-secondary">Tus citas completadas y tratamientos aparecerán aquí.</p>
                <a asp-controller="Citas" asp-action="Create" class="btn btn-primary mt-3 px-4 rounded-pill">Agendar una cita</a>
            </div>
        }
        else
        {
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    
                    @foreach (var cita in Model.OrderByDescending(c => c.FechaHora))
                    {
                        var tratamientosCita = tratamientos.Where(t => t.IdCita == cita.IdCita).ToList();

                        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
                            <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2"></i> @cita.FechaHora.ToString("dd MMMM yyyy")</h5>
                                    <small class="opacity-75">@cita.FechaHora.ToString("HH:mm") hrs</small>
                                </div>
                                <span class="badge bg-light text-primary rounded-pill px-3 py-2">Completada</span>
                            </div>
                            
                            <div class="card-body p-4 bg-white">
                                <div class="row">
                                    <div class="col-md-5 border-end">
                                        <h6 class="text-uppercase text-muted fw-bold mb-3 small">Detalles de la Cita</h6>
                                        <p class="mb-2"><i class="bi bi-person-badge text-primary me-2"></i> <strong>Dr. @cita.NombreMedico</strong></p>
                                        <p class="mb-2"><i class="bi bi-heart-pulse text-danger me-2"></i> @cita.Especialidad</p>
                                        <p class="mb-0"><i class="bi bi-card-text text-secondary me-2"></i> Motivo: @cita.Motivo</p>
                                    </div>
                                    <div class="col-md-7 ps-md-4">
                                        <h6 class="text-uppercase text-muted fw-bold mb-3 small mt-4 mt-md-0">Tratamiento Recetado</h6>
                                        
                                        @if (tratamientosCita.Any())
                                        {
                                            @foreach(var trat in tratamientosCita)
                                            {
                                                <div class="bg-light p-3 rounded mb-2 border border-light-subtle">
                                                    <h6 class="text-primary fw-bold mb-1"><i class="bi bi-capsule me-1"></i> @trat.Medicamento</h6>
                                                    <p class="mb-1 text-dark small"><strong>Dosis:</strong> @trat.Dosis</p>
                                                    <p class="mb-1 text-dark small"><strong>Duración:</strong> @trat.Duracion</p>
                                                    @if(!string.IsNullOrEmpty(trat.Instrucciones))
                                                    {
                                                        <hr class="my-2" style="opacity: 0.1">
                                                        <p class="mb-0 text-secondary small"><i class="bi bi-info-circle me-1"></i> @trat.Instrucciones</p>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="alert alert-secondary d-flex align-items-center p-3 mb-0">
                                                <i class="bi bi-info-circle fs-4 me-3"></i>
                                                <div>
                                                    No se registraron medicamentos o tratamientos adicionales en esta visita.
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    </div>
</section>
