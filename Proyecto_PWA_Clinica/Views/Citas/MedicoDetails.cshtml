@model Proyecto_PWA_Clinica.Models.Cita

@{
    Layout = "_Layout";
    var tratamientos = ViewBag.Tratamientos as List<Proyecto_PWA_Clinica.Models.Tratamiento> ?? new();
}

<style>
body { background-color: #040d1a !important; }
.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px; position: relative;
}
.page-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
}
/* top bar */
.top-bar {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
    position: relative; z-index: 1;
}
.top-bar h1 { font-size: 1.5rem; font-weight: 800; color: #fff; margin-bottom: 3px; }
.top-bar p  { color: rgba(255,255,255,.4); font-size: .88rem; margin: 0; }
/* alerts */
.dark-alert { border-radius: 12px; padding: 12px 18px; font-size: .87rem; display: flex; align-items: center; gap: 10px; margin-bottom: 18px; position: relative; z-index:1; }
.dark-alert.success { background:rgba(16,185,129,.1); border:1px solid rgba(16,185,129,.25); color:#6ee7b7; }
.dark-alert.danger  { background:rgba(239,68,68,.1);  border:1px solid rgba(239,68,68,.25);  color:#fca5a5; }
.dark-alert .btn-close-dark { background: transparent; border: none; color: inherit; cursor: pointer; margin-left: auto; opacity: .6; }
/* dark card */
.dark-card {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 22px; overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,.28);
    position: relative; z-index: 1;
}
.dark-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 16px 24px;
    display: flex; align-items: center; gap: 10px;
}
.dch-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4); display: flex; align-items: center; justify-content: center; font-size: .9rem; color: #0d9488; }
.dch-title { font-size: .93rem; font-weight: 700; color: #fff; }
.dark-card-body { padding: 24px; }
/* info grid */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@@media (max-width:576px) { .info-grid { grid-template-columns: 1fr; } }
.info-block { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07); border-radius: 12px; padding: 14px 16px; }
.info-block.full { grid-column: 1 / -1; }
.ib-label { font-size: .68rem; color: rgba(255,255,255,.3); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; }
.ib-value { color: #fff; font-weight: 600; font-size: .88rem; }
/* badge */
.sbadge { display: inline-flex; align-items: center; gap: 5px; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; border-radius: 7px; padding: 4px 10px; }
.sbadge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.sbadge.pend { background:rgba(245,158,11,.12); color:#f59e0b; border:1px solid rgba(245,158,11,.25); }
.sbadge.comp { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.sbadge.canc { background:rgba(239,68,68,.12);  color:#ef4444; border:1px solid rgba(239,68,68,.25); }
/* table */
.dark-table { width: 100%; border-collapse: collapse; }
.dark-table thead tr { background: rgba(255,255,255,.04); border-bottom: 1px solid rgba(255,255,255,.07); }
.dark-table thead th { padding: 10px 16px; font-size: .67rem; font-weight: 700; color: rgba(255,255,255,.3); text-transform: uppercase; letter-spacing: .07em; }
.dark-table tbody tr { border-bottom: 1px solid rgba(255,255,255,.04); }
.dark-table tbody tr:last-child { border-bottom: none; }
.dark-table td { padding: 12px 16px; color: rgba(255,255,255,.7); font-size: .85rem; vertical-align: top; }
.empty-inline { padding: 36px 16px; text-align: center; color: rgba(255,255,255,.3); font-size: .85rem; }
.empty-inline i { display: block; font-size: 1.5rem; margin-bottom: 8px; color: rgba(255,255,255,.1); }
/* form fields */
.form-label-dark { display: block; font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 7px; }
.dark-input, .dark-textarea {
    width: 100%; background: rgba(255,255,255,.06); border: 1.5px solid rgba(255,255,255,.08);
    border-radius: 10px; padding: 10px 13px; color: #fff; font-size: .87rem; outline: none;
    transition: border-color .2s, background .2s;
}
.dark-input::placeholder, .dark-textarea::placeholder { color: rgba(255,255,255,.2); }
.dark-input:focus, .dark-textarea:focus { border-color: rgba(13,148,136,.5); background: rgba(13,148,136,.06); }
.dark-textarea { resize: vertical; min-height: 90px; }
.field-wrap { margin-bottom: 16px; }
.btn-primary-dark {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 7px;
    background: #0d9488; color: #fff; border: none; border-radius: 10px;
    padding: 12px; font-size: .88rem; font-weight: 700;
    cursor: pointer; transition: background .2s;
}
.btn-primary-dark:hover { background: #0f766e; }
/* completar card */
.completar-card {
    background: rgba(16,185,129,.06); border: 1px solid rgba(16,185,129,.2);
    border-radius: 22px; overflow: hidden; position: relative; z-index: 1;
}
.completar-card .cc-header {
    background: rgba(16,185,129,.1); border-bottom: 1px solid rgba(16,185,129,.15);
    padding: 16px 24px; display: flex; align-items: center; gap: 10px;
}
.cc-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(16,185,129,.15); border: 1px solid rgba(16,185,129,.3); display: flex; align-items: center; justify-content: center; color: #10b981; font-size: .9rem; }
.completar-card .cc-body { padding: 22px 24px; }
.completar-card p { color: rgba(255,255,255,.4); font-size: .85rem; margin-bottom: 18px; line-height: 1.65; }
.btn-complete {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 7px;
    background: rgba(16,185,129,.15); color: #10b981;
    border: 1.5px solid rgba(16,185,129,.3); border-radius: 10px;
    padding: 12px; font-size: .9rem; font-weight: 700;
    cursor: pointer; transition: background .2s, color .2s;
}
.btn-complete:hover { background: #10b981; color: #fff; }
.btn-ghost { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: rgba(255,255,255,.5); border: 1.5px solid rgba(255,255,255,.15); border-radius: 12px; padding: 10px 20px; font-size: .88rem; font-weight: 600; text-decoration: none; transition: border-color .2s, color .2s; }
.btn-ghost:hover { border-color: rgba(255,255,255,.35); color: #fff; }
</style>

<div class="page-wrap">
    <div class="container-xl" style="max-width:1060px;">

        <div class="top-bar" data-aos="fade-down">
            <div>
                <h1>Detalle de Cita</h1>
                <p>Atención médica y registro de tratamiento</p>
            </div>
            <a asp-action="MedicoIndex" class="btn-ghost">
                <i class="bi bi-arrow-left"></i> Volver a Mis Citas
            </a>
        </div>

        @if (TempData["MensajeExito"] != null)
        { <div class="dark-alert success" data-aos="fade-down"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"] <button class="btn-close-dark" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button></div> }
        @if (TempData["MensajeError"] != null)
        { <div class="dark-alert danger" data-aos="fade-down"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensajeError"] <button class="btn-close-dark" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button></div> }

        <div class="row g-4" data-aos="fade-up">

            <!-- Columna izquierda -->
            <div class="col-lg-7 d-flex flex-column gap-4">

                <!-- Info cita -->
                <div class="dark-card">
                    <div class="dark-card-header">
                        <div class="dch-icon"><i class="bi bi-clipboard2-pulse"></i></div>
                        <span class="dch-title">Información de la cita</span>
                    </div>
                    <div class="dark-card-body">
                        <div class="info-grid">
                            <div class="info-block"><div class="ib-label">Paciente</div><div class="ib-value">@Model.NombrePaciente</div></div>
                            <div class="info-block"><div class="ib-label">Médico</div><div class="ib-value">@Model.NombreMedico</div></div>
                            <div class="info-block"><div class="ib-label">Especialidad</div><div class="ib-value">@Model.Especialidad</div></div>
                            <div class="info-block"><div class="ib-label">Fecha y hora</div><div class="ib-value">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</div></div>
                            <div class="info-block">
                                <div class="ib-label">Estado</div>
                                <div>
                                    @if (Model.EstadoCita == "Pendiente")   { <span class="sbadge pend">Pendiente</span> }
                                    else if (Model.EstadoCita == "Completada") { <span class="sbadge comp">Completada</span> }
                                    else { <span class="sbadge canc">@Model.EstadoCita</span> }
                                </div>
                            </div>
                            <div class="info-block"><div class="ib-label">ID de cita</div><div class="ib-value" style="font-family:'Courier New',monospace; color:rgba(13,148,136,.8);">#@Model.IdCita</div></div>
                            <div class="info-block full"><div class="ib-label">Motivo de consulta</div><div class="ib-value">@Model.Motivo</div></div>
                            @if (!string.IsNullOrWhiteSpace(Model.NotasMedico))
                            {
                                <div class="info-block full"><div class="ib-label">Notas médicas</div><div class="ib-value">@Model.NotasMedico</div></div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tratamientos registrados -->
                <div class="dark-card">
                    <div class="dark-card-header">
                        <div class="dch-icon"><i class="bi bi-capsule"></i></div>
                        <span class="dch-title">Tratamientos registrados</span>
                    </div>
                    @if (tratamientos.Any())
                    {
                        <div class="table-responsive">
                            <table class="dark-table">
                                <thead>
                                    <tr>
                                        <th>Medicamento</th>
                                        <th>Dosis</th>
                                        <th>Duración</th>
                                        <th>Instrucciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in tratamientos)
                                    {
                                        <tr>
                                            <td style="color:#fff; font-weight:600;">@t.Medicamento</td>
                                            <td>@t.Dosis</td>
                                            <td>@t.Duracion</td>
                                            <td style="color:rgba(255,255,255,.5);">@t.Instrucciones</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-inline">
                            <i class="bi bi-capsule"></i>
                            Todavía no hay tratamientos registrados para esta cita.
                        </div>
                    }
                </div>
            </div>

            <!-- Columna derecha -->
            <div class="col-lg-5 d-flex flex-column gap-4">

                <!-- Registrar tratamiento -->
                <div class="dark-card">
                    <div class="dark-card-header">
                        <div class="dch-icon"><i class="bi bi-plus-circle"></i></div>
                        <span class="dch-title">Registrar tratamiento</span>
                    </div>
                    <div class="dark-card-body">
                        <form asp-controller="HistorialMedico" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="IdCita" value="@Model.IdCita" />
                            <div class="field-wrap">
                                <label class="form-label-dark">Medicamento</label>
                                <input name="Medicamento" class="dark-input" placeholder="Nombre del medicamento" required />
                            </div>
                            <div class="field-wrap">
                                <label class="form-label-dark">Dosis</label>
                                <input name="Dosis" class="dark-input" placeholder="Ej: 500mg cada 8h" required />
                            </div>
                            <div class="field-wrap">
                                <label class="form-label-dark">Duración</label>
                                <input name="Duracion" class="dark-input" placeholder="Ej: 7 días" required />
                            </div>
                            <div class="field-wrap">
                                <label class="form-label-dark">Instrucciones</label>
                                <textarea name="Instrucciones" class="dark-textarea" placeholder="Indicaciones adicionales..."></textarea>
                            </div>
                            <button type="submit" class="btn-primary-dark">
                                <i class="bi bi-plus-lg"></i> Guardar tratamiento
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Finalizar consulta -->
                @if (Model.EstadoCita == "Pendiente")
                {
                    <div class="completar-card">
                        <div class="cc-header">
                            <div class="cc-icon"><i class="bi bi-check-circle"></i></div>
                            <span class="dch-title" style="color:#10b981;">Finalizar consulta</span>
                        </div>
                        <div class="cc-body">
                            <p>Cuando hayas terminado la atención y registrado el tratamiento, podés marcar la cita como completada.</p>
                            <form asp-action="Completar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.IdCita" />
                                <button type="submit" class="btn-complete">
                                    <i class="bi bi-check2-circle"></i> Marcar como completada
                                </button>
                            </form>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
