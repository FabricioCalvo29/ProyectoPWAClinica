@model List<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
    var total      = Model?.Count ?? 0;
    var pendientes = Model?.Count(c => c.EstadoCita == "Pendiente") ?? 0;
    var completadas = Model?.Count(c => c.EstadoCita == "Completada") ?? 0;
}

<style>
body { background-color: #040d1a !important; }
.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px; position: relative;
}
.page-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
}
.page-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 24px; gap: 14px; flex-wrap: wrap;
    position: relative; z-index: 1;
}
.page-header h1 { font-size: 1.6rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
.page-header p  { color: rgba(255,255,255,.4); font-size: .9rem; margin: 0; }
/* mini stats */
.mini-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; position: relative; z-index: 1; }
.mini-stat {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 14px; padding: 13px 18px;
    display: flex; align-items: center; gap: 10px; min-width: 140px;
}
.mini-stat .ms-icon { width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: .85rem; flex-shrink: 0; }
.ms-total  .ms-icon { background:rgba(99,102,241,.15); color:#818cf8; border:1px solid rgba(99,102,241,.25); }
.ms-pend   .ms-icon { background:rgba(245,158,11,.15); color:#f59e0b; border:1px solid rgba(245,158,11,.25); }
.ms-comp   .ms-icon { background:rgba(16,185,129,.15); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.ms-num { font-size: 1.2rem; font-weight: 800; color: #fff; line-height: 1; }
.ms-lbl { font-size: .68rem; color: rgba(255,255,255,.35); text-transform: uppercase; letter-spacing: .05em; }
/* filter card */
.filter-card {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 18px; padding: 22px 24px; margin-bottom: 20px;
    position: relative; z-index: 1;
}
.filter-card-header {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 18px; font-size: .78rem; font-weight: 700;
    color: rgba(13,148,136,.7); text-transform: uppercase; letter-spacing: .08em;
}
.form-label-dark { display: block; font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 7px; }
.dark-input, .dark-select {
    width: 100%; background: rgba(255,255,255,.06);
    border: 1.5px solid rgba(255,255,255,.08); border-radius: 10px;
    padding: 9px 12px; color: #fff; font-size: .85rem; outline: none;
    transition: border-color .2s, background .2s;
}
.dark-select { appearance: none; }
.dark-select option { background: #071428; color: #fff; }
.dark-input::placeholder { color: rgba(255,255,255,.2); }
.dark-input:focus, .dark-select:focus { border-color: rgba(13,148,136,.5); background: rgba(13,148,136,.06); }
input[type="date"].dark-input::-webkit-calendar-picker-indicator { filter: invert(.4); cursor: pointer; }
.filter-actions { display: flex; gap: 8px; align-items: flex-end; }
.btn-filter {
    display: inline-flex; align-items: center; gap: 6px;
    background: #0d9488; color: #fff; border: none; border-radius: 10px;
    padding: 9px 18px; font-size: .83rem; font-weight: 700;
    cursor: pointer; transition: background .15s; white-space: nowrap;
}
.btn-filter:hover { background: #0f766e; }
.btn-clear {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; color: rgba(255,255,255,.4);
    border: 1.5px solid rgba(255,255,255,.1); border-radius: 10px;
    padding: 9px 16px; font-size: .83rem; font-weight: 600;
    text-decoration: none; transition: border-color .2s, color .2s; white-space: nowrap;
}
.btn-clear:hover { border-color: rgba(255,255,255,.3); color: #fff; }
/* main table card */
.main-card {
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.09);
    border-radius: 22px; overflow: hidden;
    box-shadow: 0 28px 70px rgba(0,0,0,.3);
    position: relative; z-index: 1;
}
.main-card-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 16px 24px;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
}
.mch-left { display: flex; align-items: center; gap: 10px; }
.mch-icon { width: 36px; height: 36px; border-radius: 10px; background: rgba(13,148,136,.2); border: 1.5px solid rgba(13,148,136,.4); display: flex; align-items: center; justify-content: center; font-size: .9rem; color: #0d9488; }
.mch-title { font-size: .93rem; font-weight: 700; color: #fff; }
.dark-table { width: 100%; border-collapse: collapse; }
.dark-table thead tr { background: rgba(255,255,255,.04); border-bottom: 1px solid rgba(255,255,255,.07); }
.dark-table thead th { padding: 11px 18px; font-size: .67rem; font-weight: 700; color: rgba(255,255,255,.3); text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
.dark-table tbody tr { border-bottom: 1px solid rgba(255,255,255,.04); transition: background .15s; }
.dark-table tbody tr:hover { background: rgba(13,148,136,.05); }
.dark-table tbody tr:last-child { border-bottom: none; }
.dark-table td { padding: 13px 18px; color: rgba(255,255,255,.7); font-size: .86rem; vertical-align: middle; }
.dark-table td .main-text { color: #fff; font-weight: 600; }
.dark-table td .sub-text  { color: rgba(255,255,255,.3); font-size: .76rem; margin-top: 1px; }
.sbadge { display: inline-flex; align-items: center; gap: 5px; font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; border-radius: 7px; padding: 3px 9px; }
.sbadge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.sbadge.pend { background:rgba(245,158,11,.12); color:#f59e0b; border:1px solid rgba(245,158,11,.25); }
.sbadge.comp { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.sbadge.canc { background:rgba(239,68,68,.12);  color:#ef4444; border:1px solid rgba(239,68,68,.25); }
.btn-detail {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(13,148,136,.1); color: #0d9488;
    border: 1px solid rgba(13,148,136,.25); border-radius: 8px;
    padding: 5px 12px; font-size: .78rem; font-weight: 600;
    text-decoration: none; transition: background .15s;
}
.btn-detail:hover { background: rgba(13,148,136,.22); color: #5eead4; }
.empty-state { padding: 60px 20px; text-align: center; color: rgba(255,255,255,.3); font-size: .87rem; }
.empty-state i { display: block; font-size: 1.8rem; margin-bottom: 10px; color: rgba(255,255,255,.12); }
/* alerts */
.dark-alert { border-radius: 12px; padding: 12px 18px; font-size: .87rem; display: flex; align-items: center; gap: 10px; margin-bottom: 18px; position: relative; z-index:1; }
.dark-alert.success { background:rgba(16,185,129,.1); border:1px solid rgba(16,185,129,.25); color:#6ee7b7; }
.dark-alert.danger  { background:rgba(239,68,68,.1);  border:1px solid rgba(239,68,68,.25);  color:#fca5a5; }
.btn-ghost { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: rgba(255,255,255,.5); border: 1.5px solid rgba(255,255,255,.15); border-radius: 12px; padding: 10px 20px; font-size: .88rem; font-weight: 600; text-decoration: none; transition: border-color .2s, color .2s; }
.btn-ghost:hover { border-color: rgba(255,255,255,.35); color: #fff; }
</style>

<div class="page-wrap">
    <div class="container" style="max-width:1060px;">

        <div class="page-header" data-aos="fade-down">
            <div>
                <h1>Mis Citas</h1>
                <p>Listado de citas asignadas al médico</p>
            </div>
            <a asp-controller="Home" asp-action="DashboardMedico" class="btn-ghost">
                <i class="bi bi-arrow-left"></i> Volver al Panel
            </a>
        </div>

        @if (TempData["MensajeExito"] != null)
        { <div class="dark-alert success" data-aos="fade-down"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div> }
        @if (TempData["MensajeError"] != null)
        { <div class="dark-alert danger" data-aos="fade-down"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensajeError"]</div> }

        <!-- Mini stats -->
        <div class="mini-stats" data-aos="fade-up" data-aos-delay="40">
            <div class="mini-stat ms-total"><div class="ms-icon"><i class="bi bi-calendar3"></i></div><div><div class="ms-num">@total</div><div class="ms-lbl">Total</div></div></div>
            <div class="mini-stat ms-pend"><div class="ms-icon"><i class="bi bi-hourglass-split"></i></div><div><div class="ms-num">@pendientes</div><div class="ms-lbl">Pendientes</div></div></div>
            <div class="mini-stat ms-comp"><div class="ms-icon"><i class="bi bi-check-circle"></i></div><div><div class="ms-num">@completadas</div><div class="ms-lbl">Completadas</div></div></div>
        </div>

        <!-- Filtros -->
        <div class="filter-card" data-aos="fade-up" data-aos-delay="60">
            <div class="filter-card-header"><i class="bi bi-funnel"></i> Filtros de búsqueda</div>
            <form method="get" asp-action="MedicoIndex">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label-dark">Nombre del paciente</label>
                        <input type="text" name="nombrePaciente" value="@ViewBag.NombrePaciente" class="dark-input" placeholder="Buscar por nombre" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-dark">Estado</label>
                        <select name="estadoCita" class="dark-select">
                            <option value="" selected="@(string.IsNullOrEmpty((string?)ViewBag.EstadoCita))">Todos</option>
                            <option value="Pendiente"  selected="@((string?)ViewBag.EstadoCita == "Pendiente")">Pendiente</option>
                            <option value="Completada" selected="@((string?)ViewBag.EstadoCita == "Completada")">Completada</option>
                            <option value="Cancelada"  selected="@((string?)ViewBag.EstadoCita == "Cancelada")">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-dark">Desde</label>
                        <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde" class="dark-input" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-dark">Hasta</label>
                        <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta" class="dark-input" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label-dark">Orden</label>
                        <select name="orden" class="dark-select">
                            <option value="asc"  selected="@((string?)ViewBag.Orden == "asc")">Más próxima</option>
                            <option value="desc" selected="@((string?)ViewBag.Orden == "desc")">Más reciente</option>
                        </select>
                    </div>
                    <div class="col-md-1 filter-actions">
                        <button type="submit" class="btn-filter"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                <div style="text-align:right; margin-top:12px;">
                    <a asp-action="MedicoIndex" class="btn-clear"><i class="bi bi-x-circle"></i> Limpiar filtros</a>
                </div>
            </form>
        </div>

        <!-- Tabla -->
        <div class="main-card" data-aos="fade-up" data-aos-delay="80">
            <div class="main-card-header">
                <div class="mch-left">
                    <div class="mch-icon"><i class="bi bi-calendar-week"></i></div>
                    <span class="mch-title">Agenda de citas</span>
                </div>
                <span style="color:rgba(255,255,255,.3); font-size:.78rem;">@total resultado@(total != 1 ? "s" : "")</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="dark-table">
                        <thead>
                            <tr>
                                <th>Paciente</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model)
                            {
                                <tr>
                                    <td><span class="main-text">@cita.NombrePaciente</span></td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy")</td>
                                    <td><span style="color:rgba(13,148,136,.8); font-weight:600;">@cita.FechaHora.ToString("HH:mm")</span></td>
                                    <td style="max-width:160px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@cita.Motivo</td>
                                    <td>
                                        @if (cita.EstadoCita == "Pendiente")   { <span class="sbadge pend">Pendiente</span> }
                                        else if (cita.EstadoCita == "Completada") { <span class="sbadge comp">Completada</span> }
                                        else { <span class="sbadge canc">@cita.EstadoCita</span> }
                                    </td>
                                    <td>
                                        <a asp-action="MedicoDetails" asp-route-id="@cita.IdCita" class="btn-detail">
                                            Ver detalle <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    No hay citas que coincidan con los filtros seleccionados.
                </div>
            }
        </div>

    </div>
</div>
