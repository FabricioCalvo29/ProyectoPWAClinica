@model IEnumerable<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
}

<div class="container mt-5 pt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Citas</h1>
            <p class="mb-0">Consulta y administra tus citas registradas.</p>
        </div>
        <a asp-controller="Citas" asp-action="Create" class="btn btn-primary">Agendar cita</a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No tienes citas registradas en este momento.
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y hora</th>
                            <th>Medico</th>
                            <th>Especialidad</th>
                            <th>Estado</th>
                            <th>Motivo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in Model)
                        {
                            <tr>
                                <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@cita.NombreMedico</td>
                                <td>@cita.Especialidad</td>
                                <td>@cita.EstadoCita</td>
                                <td>@cita.Motivo</td>
                                <td class="text-end">
                                    <a asp-controller="Citas"
                                       asp-action="Details"
                                       asp-route-id="@cita.IdCita"
                                       class="btn btn-outline-primary btn-sm">
                                        Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
