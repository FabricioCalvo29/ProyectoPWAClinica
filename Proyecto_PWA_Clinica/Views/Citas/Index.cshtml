@model IEnumerable<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
}

<style>
body { background-color: #040d1a !important; }

.page-wrap {
    min-height: 100vh;
    background: #040d1a;
    padding: 100px 0 60px;
}

/* ── PAGE HEADER ── */
.page-header {
    background: linear-gradient(135deg, rgba(13,148,136,.15) 0%, rgba(8,30,60,.5) 100%);
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: 36px 0 32px;
    margin-bottom: 40px;
    position: relative; overflow: hidden;
}
.page-header::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.05) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
}
.page-header-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
.page-title { font-size: 1.7rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
.page-sub   { color: rgba(255,255,255,.4); font-size: .9rem; margin: 0; }

.btn-primary-dark {
    display: inline-flex; align-items: center; gap: 8px;
    background: #0d9488; color: #fff;
    border: none; border-radius: 12px;
    padding: 11px 22px; font-size: .88rem; font-weight: 700;
    text-decoration: none; transition: background .2s, transform .15s;
}
.btn-primary-dark:hover { background: #0f766e; color: #fff; transform: translateY(-1px); }

/* ── ALERTS ── */
.dark-alert {
    border-radius: 12px; padding: 14px 18px;
    font-size: .9rem; margin-bottom: 24px;
    display: flex; align-items: center; gap: 10px;
}
.dark-alert.success { background: rgba(34,197,94,.1);  border: 1px solid rgba(34,197,94,.3);  color: #86efac; }
.dark-alert.danger  { background: rgba(239,68,68,.1);  border: 1px solid rgba(239,68,68,.3);  color: #fca5a5; }
.dark-alert.info    { background: rgba(59,130,246,.1); border: 1px solid rgba(59,130,246,.3); color: #93c5fd; }

/* ── TABLE CARD ── */
.table-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 20px; overflow: hidden;
}
.dark-table { width: 100%; border-collapse: collapse; }
.dark-table thead tr {
    background: rgba(13,148,136,.08);
    border-bottom: 1px solid rgba(255,255,255,.07);
}
.dark-table thead th {
    padding: 14px 20px;
    font-size: .72rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase;
    color: rgba(255,255,255,.4);
}
.dark-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,.04);
    transition: background .15s;
}
.dark-table tbody tr:last-child { border-bottom: none; }
.dark-table tbody tr:hover { background: rgba(255,255,255,.03); }
.dark-table td {
    padding: 16px 20px;
    font-size: .88rem; color: rgba(255,255,255,.7);
    vertical-align: middle;
}
.td-strong { font-weight: 700; color: #fff; }

/* ── ESTADO BADGE ── */
.estado-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 50px;
    font-size: .72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
}
.estado-badge.pendiente  { background: rgba(245,158,11,.15); color: #fbbf24; border: 1px solid rgba(245,158,11,.3); }
.estado-badge.completada { background: rgba(34,197,94,.12);  color: #4ade80; border: 1px solid rgba(34,197,94,.3); }
.estado-badge.cancelada  { background: rgba(239,68,68,.12);  color: #f87171; border: 1px solid rgba(239,68,68,.3); }

.btn-outline-teal {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px; border-radius: 8px;
    border: 1.5px solid rgba(13,148,136,.5); color: #0d9488;
    font-size: .8rem; font-weight: 700;
    text-decoration: none; transition: background .2s, color .2s;
    background: transparent;
}
.btn-outline-teal:hover { background: #0d9488; color: #fff; border-color: #0d9488; }

/* ── EMPTY ── */
.empty-state {
    text-align: center; padding: 64px 24px;
}
.empty-state i { font-size: 3rem; color: rgba(255,255,255,.1); display: block; margin-bottom: 16px; }
.empty-state h5 { color: rgba(255,255,255,.4); font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
.empty-state p  { color: rgba(255,255,255,.25); font-size: .88rem; margin-bottom: 24px; }
</style>

<div class="page-wrap">

    <div class="page-header">
        <div class="container page-header-inner">
            <div>
                <div class="page-title"><i class="bi bi-calendar-check me-2" style="color:#0d9488;"></i>Mis Citas</div>
                <p class="page-sub">Consulta y administra tus citas registradas</p>
            </div>
            <a asp-controller="Citas" asp-action="Create" class="btn-primary-dark">
                <i class="bi bi-plus-lg"></i> Agendar cita
            </a>
        </div>
    </div>

    <div class="container">

        @if (TempData["MensajeExito"] != null)
        {
            <div class="dark-alert success"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="dark-alert danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensajeError"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="table-card">
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h5>No tienes citas registradas</h5>
                    <p>Agenda tu primera cita con uno de nuestros especialistas.</p>
                    <a asp-controller="Citas" asp-action="Create" class="btn-primary-dark">
                        <i class="bi bi-plus-lg"></i> Agendar cita
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-card" data-aos="fade-up">
                <div class="table-responsive">
                    <table class="dark-table">
                        <thead>
                            <tr>
                                <th>Fecha y hora</th>
                                <th>Médico</th>
                                <th>Especialidad</th>
                                <th>Estado</th>
                                <th>Motivo</th>
                                <th style="text-align:right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model)
                            {
                                var estadoClass = cita.EstadoCita?.ToLower() switch {
                                    "completada" => "completada",
                                    "cancelada"  => "cancelada",
                                    _            => "pendiente"
                                };
                                <tr>
                                    <td class="td-strong">
                                        <i class="bi bi-calendar3 me-1" style="color:#0d9488;"></i>
                                        @cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>@cita.NombreMedico</td>
                                    <td>@cita.Especialidad</td>
                                    <td>
                                        <span class="estado-badge @estadoClass">@cita.EstadoCita</span>
                                    </td>
                                    <td style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@cita.Motivo</td>
                                    <td style="text-align:right;">
                                        <a asp-controller="Citas"
                                           asp-action="Details"
                                           asp-route-id="@cita.IdCita"
                                           class="btn-outline-teal">
                                            <i class="bi bi-eye"></i> Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>
