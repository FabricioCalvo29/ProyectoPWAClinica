@model IEnumerable<Proyecto_PWA_Clinica.Models.Cita>

@{
    Layout = "_Layout";
}

<div class="container" style="margin-top: 120px; min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Control Global de Citas</h2>
            <p class="text-secondary mb-0">Vista administrativa de la agenda general de la clínica.</p>
        </div>
        <a asp-controller="Home" asp-action="DashboardAdmin" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Volver al Panel
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 rounded-4 shadow-sm">
            <i class="bi bi-calendar-x d-block fs-1 mb-3"></i>
            No hay citas registradas en el sistema en la historia.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Paciente</th>
                            <th>Doctor Asignado</th>
                            <th>Fecha</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Decisión</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var cita in Model.OrderByDescending(c => c.FechaHora))
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@cita.IdCita</td>
                                <td><i class="bi bi-person text-secondary me-1"></i> Paciente @cita.IdPaciente</td>
                                <td>Dr. @cita.NombreMedico <br/><small class="text-muted">@cita.Especialidad</small></td>
                                <td>@cita.FechaHora.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="text-truncate" style="max-width: 150px;">@cita.Motivo</td>
                                <td>
                                    @if(cita.EstadoCita == "Pendiente") { <span class="badge bg-warning text-dark px-2 rounded-pill">@cita.EstadoCita</span> }
                                    else if(cita.EstadoCita == "Completada") { <span class="badge bg-success px-2 rounded-pill">@cita.EstadoCita</span> }
                                    else { <span class="badge bg-danger px-2 rounded-pill">@cita.EstadoCita</span> }
                                </td>
                                <td class="text-end pe-4">
                                    @if(cita.EstadoCita == "Pendiente")
                                    {
                                        <!-- En futuro, los admins pueden marcar completado o cancelar por el paciente acá -->
                                        <button class="btn btn-sm btn-outline-success rounded-pill" disabled><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill" disabled><i class="bi bi-x-lg"></i></button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Cerrada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
