@model IEnumerable<Proyecto_PWA_Clinica.Models.Paciente>

@{
    Layout = "_Layout";
}

<div class="container" style="margin-top: 120px; min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Gestión de Pacientes</h2>
            <p class="text-secondary mb-0">Directorio y control poblacional de la clínica.</p>
        </div>
        <a asp-controller="Home" asp-action="DashboardAdmin" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 rounded-4 shadow-sm">
            <i class="bi bi-people d-block fs-1 mb-3"></i>
            Aún no hay pacientes registrados en el sistema.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Paciente</th>
                            <th>Contacto</th>
                            <th>Sangre</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">#@item.IdPaciente</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                            @item.NombreCompleto.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.NombreCompleto</h6>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-envelope text-muted me-1"></i> @item.Correo <br/>
                                        <i class="bi bi-telephone text-muted me-1"></i> @(item.Telefono ?? "N/A")
                                    </div>
                                </td>
                                <td><span class="badge bg-danger text-white rounded-pill">@(item.TipoSangre ?? "NR")</span></td>
                                <td>
                                    @if(item.Estado)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 rounded-pill border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-3 rounded-pill border border-danger-subtle">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.IdPaciente" class="btn btn-sm btn-light border text-primary rounded-pill px-3">
                                        Detalles <i class="bi bi-chevron-right ms-1 small"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
