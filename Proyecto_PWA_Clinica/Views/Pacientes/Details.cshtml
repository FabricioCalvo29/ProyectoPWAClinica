@model Proyecto_PWA_Clinica.Models.Paciente

@{
    Layout = "_Layout";
}

<style>
body { background-color: #040d1a !important; }
.page-wrap {
    min-height: 100vh; background: #040d1a;
    padding: 100px 0 60px; position: relative;
}
.page-wrap::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(13,148,136,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(13,148,136,.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none;
}
.back-link {
    display: inline-flex; align-items: center; gap: 7px;
    color: rgba(255,255,255,.35); font-size: .85rem; text-decoration: none;
    margin-bottom: 24px; transition: color .2s;
    position: relative; z-index: 1;
}
.back-link:hover { color: #0d9488; }
.detail-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 24px; overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,.35);
    position: relative; z-index: 1;
}
/* profile header */
.profile-header {
    background: linear-gradient(135deg, rgba(13,148,136,.2) 0%, rgba(8,30,60,.6) 100%);
    border-bottom: 1px solid rgba(13,148,136,.2);
    padding: 32px 36px;
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
.profile-avatar {
    width: 68px; height: 68px; border-radius: 20px;
    background: linear-gradient(135deg, rgba(13,148,136,.5), rgba(99,102,241,.5));
    border: 2px solid rgba(13,148,136,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; font-weight: 800; color: #fff; flex-shrink: 0;
}
.profile-info h1 { font-size: 1.4rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
.profile-info p  { color: rgba(255,255,255,.35); font-size: .85rem; margin: 0; font-family: 'Courier New', monospace; }
/* body */
.detail-body { padding: 32px 36px; }
.section-label {
    font-size: .68rem; font-weight: 700; color: rgba(13,148,136,.7);
    text-transform: uppercase; letter-spacing: .1em;
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
}
.section-label::after { content: ''; flex: 1; height: 1px; background: rgba(13,148,136,.15); }
/* info blocks */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px; }
@@media (max-width: 576px) { .info-grid { grid-template-columns: 1fr; } }
.info-block {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 14px; padding: 16px 18px;
}
.info-block .ib-label {
    font-size: .7rem; color: rgba(255,255,255,.3); font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px;
}
.info-block .ib-value { color: #fff; font-weight: 600; font-size: .9rem; }
.info-block .ib-value.blood {
    font-size: 1.6rem; font-weight: 900; color: #fca5a5; line-height: 1;
}
.info-block.blood-block {
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(239,68,68,.06); border-color: rgba(239,68,68,.15);
}
.blood-icon { font-size: 2rem; color: rgba(239,68,68,.2); }
/* status bar */
.status-bar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 14px; padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,.06);
}
.sbadge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .75rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; border-radius: 8px; padding: 5px 12px;
}
.sbadge::before { content:''; width:6px; height:6px; border-radius:50%; background:currentColor; flex-shrink:0; }
.sbadge.active   { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.25); }
.sbadge.inactive { background:rgba(239,68,68,.12);  color:#ef4444; border:1px solid rgba(239,68,68,.25); }
.btn-danger-dark {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(239,68,68,.1); color: #ef4444;
    border: 1.5px solid rgba(239,68,68,.25); border-radius: 10px;
    padding: 9px 18px; font-size: .83rem; font-weight: 700;
    cursor: pointer; transition: background .2s;
}
.btn-danger-dark:hover { background: rgba(239,68,68,.2); color: #fca5a5; }
</style>

<div class="page-wrap">
    <div class="container" style="max-width: 680px;">

        <a asp-action="Index" class="back-link" data-aos="fade-down">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>

        <div class="detail-card" data-aos="fade-up">

            <!-- Profile header -->
            <div class="profile-header">
                <div class="profile-avatar">@Model.NombreCompleto.Substring(0,1).ToUpper()</div>
                <div class="profile-info">
                    <h1>@Model.NombreCompleto</h1>
                    <p>Expediente Médico #@Model.IdPaciente</p>
                </div>
            </div>

            <div class="detail-body">

                <!-- Contacto -->
                <div class="section-label"><i class="bi bi-person-lines-fill"></i> Información de contacto</div>
                <div class="info-grid" style="grid-template-columns: 1fr;">
                    <div class="info-block">
                        <div class="ib-label"><i class="bi bi-envelope" style="margin-right:5px;"></i>Correo</div>
                        <div class="ib-value">@Model.Correo</div>
                    </div>
                    <div class="info-block">
                        <div class="ib-label"><i class="bi bi-telephone" style="margin-right:5px;"></i>Teléfono</div>
                        <div class="ib-value">@(Model.Telefono ?? "No registrado")</div>
                    </div>
                </div>

                <!-- Clínicos -->
                <div class="section-label" style="margin-top:8px;"><i class="bi bi-droplet-half"></i> Datos clínicos</div>
                <div class="info-block blood-block" style="margin-bottom:28px;">
                    <div>
                        <div class="ib-label">Tipo de sangre</div>
                        <div class="ib-value blood">@(Model.TipoSangre ?? "NR")</div>
                    </div>
                    <i class="bi bi-droplet-half blood-icon"></i>
                </div>

                <!-- Estado + Acción -->
                <div class="status-bar">
                    <div>
                        <div style="font-size:.7rem; color:rgba(255,255,255,.3); text-transform:uppercase; letter-spacing:.06em; margin-bottom:7px;">Estado de la cuenta</div>
                        @if (Model.Estado)
                        { <span class="sbadge active"><i class="bi bi-check-circle" style="margin-right:2px;"></i>Paciente activo</span> }
                        else
                        { <span class="sbadge inactive"><i class="bi bi-x-octagon" style="margin-right:2px;"></i>Cuenta suspendida</span> }
                    </div>
                    <button class="btn-danger-dark" disabled title="Función no disponible en Fase 1">
                        <i class="bi bi-trash3"></i> Dar de baja
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
