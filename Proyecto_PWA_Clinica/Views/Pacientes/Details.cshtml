@model Proyecto_PWA_Clinica.Models.Paciente

@{
    Layout = "_Layout";
}

<div class="container" style="margin-top: 120px; min-height: 80vh;">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden max-w-lg mx-auto">
        <div class="card-header bg-primary text-white p-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-circle fs-1 me-3"></i>
                <div>
                    <h3 class="mb-0 fw-bold">@Model.NombreCompleto</h3>
                    <p class="mb-0 text-white-50">Expediente Médico #@Model.IdPaciente</p>
                </div>
            </div>
        </div>
        
        <div class="card-body p-4 p-md-5 bg-white">
            <div class="row g-4">
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase fw-bold small mb-2">Información de Contacto</h6>
                    <div class="p-3 bg-light rounded border border-light-subtle">
                        <p class="mb-2"><i class="bi bi-envelope-fill text-primary me-2"></i> <strong>@Model.Correo</strong></p>
                        <p class="mb-0"><i class="bi bi-telephone-fill text-success me-2"></i> @(Model.Telefono ?? "Teléfono no registrado")</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase fw-bold small mb-2">Datos Clínicos</h6>
                    <div class="p-3 bg-light rounded border border-light-subtle d-flex justify-content-between align-items-center h-100">
                        <div>
                            <span class="text-secondary d-block mb-1">Tipo de Sangre</span>
                            <span class="fs-4 fw-bold text-danger">@(Model.TipoSangre ?? "No Registrado")</span>
                        </div>
                        <i class="bi bi-droplet-half fs-1 text-danger opacity-25"></i>
                    </div>
                </div>
            </div>

            <hr class="my-5 text-muted">

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase fw-bold small mb-1">Estado de la cuenta</h6>
                    @if(Model.Estado)
                    {
                        <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i> Paciente Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-octagon me-1"></i> Cuenta Suspendida</span>
                    }
                </div>
                <div>
                    <button class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-trash3 me-1"></i> Dar de Baja
                    </button>
                    <!-- Las acciones de dar de baja no fueron solicitadas en Fase 1, se queda visual por ahora. -->
                </div>
            </div>
        </div>
    </div>
</div>
