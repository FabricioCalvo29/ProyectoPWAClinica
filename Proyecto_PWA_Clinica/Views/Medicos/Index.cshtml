@model List<Proyecto_PWA_Clinica.Models.MedicoAdmin>

@{
    Layout = "_Layout";
}

<section class="section" style="padding-top: 120px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold">Gestión de Médicos</h2>
                <p class="text-muted mb-0">Administra el personal médico de la clínica.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Registrar Médico</a>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Correo institucional</th>
                                    <th>Especialidad</th>
                                    <th>Código profesional</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var medico in Model)
                                {
                                    <tr>
                                        <td>@medico.Nombre @medico.Apellido</td>
                                        <td>@medico.Correo</td>
                                        <td>@medico.Especialidad</td>
                                        <td>@medico.CodigoProfesional</td>
                                        <td>
                                            <span class="badge @(medico.Estado ? "bg-success" : "bg-secondary")">
                                                @(medico.Estado ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@medico.IdMedico" class="btn btn-sm btn-outline-primary rounded-pill">
                                                Editar
                                            </a>

                                            @if (medico.Estado)
                                            {
                                                <form asp-action="Inactivar" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idMedico" value="@medico.IdMedico" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                        Inactivar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activar" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idMedico" value="@medico.IdMedico" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                                                        Activar
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        No hay médicos registrados.
                    </div>
                }
            </div>
        </div>
    </div>
</section>